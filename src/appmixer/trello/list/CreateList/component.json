{
    "name": "appmixer.trello.list.CreateList",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Create a new list on a board.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:trello"
    },
    "quota": {
        "manager": "appmixer:trello",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "boardId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "position": {
                        "type": "string"
                    }
                },
                "required": [
                    "boardId",
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "boardId": {
                        "type": "select",
                        "label": "Board",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/trello/list/ListBoards?outPort=boards",
                            "data": {
                                "transform": "./transformers#boardsToSelectArray"
                            }
                        },
                        "tooltip": "Select a board."
                    },
                    "name": {
                        "type": "text",
                        "label": "List Name",
                        "index": 2,
                        "tooltip": "The name of the new list."
                    },
                    "position": {
                        "type": "text",
                        "label": "Position",
                        "index": 3,
                        "tooltip": "The position of the list: <code>top</code>, <code>bottom</code> or a positive number."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "list",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "List ID",
                        "example": "5abbe4b7ddc1b351ef961430"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "To Do"
                    },
                    "closed": {
                        "type": "boolean",
                        "title": "Closed",
                        "example": false
                    },
                    "idBoard": {
                        "type": "string",
                        "title": "Board ID",
                        "example": "5abbe4b7ddc1b351ef961420"
                    },
                    "pos": {
                        "type": "number",
                        "title": "Position",
                        "example": 16384
                    }
                }
            }
        }
    ]
}
