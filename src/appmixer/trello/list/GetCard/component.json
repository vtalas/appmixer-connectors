{
    "name": "appmixer.trello.list.GetCard",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Get a single card by ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:trello"
    },
    "quota": {
        "manager": "appmixer:trello",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "boardId": {
                        "type": "string"
                    },
                    "boardCardId": {
                        "type": "string"
                    }
                },
                "required": [
                    "boardCardId"
                ]
            },
            "inspector": {
                "inputs": {
                    "boardId": {
                        "type": "select",
                        "label": "Board",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/trello/list/ListBoards?outPort=boards",
                            "data": {
                                "transform": "./transformers#boardsToSelectArray"
                            }
                        },
                        "tooltip": "Select a board."
                    },
                    "boardCardId": {
                        "type": "select",
                        "label": "Card",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/trello/list/ListBoardsCards?outPort=cards",
                            "data": {
                                "messages": {
                                    "in/boardId": "inputs/in/boardId"
                                },
                                "transform": "./transformers#cardListsToSelectArray"
                            }
                        },
                        "tooltip": "Select a card."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "card",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Card ID",
                        "example": "5abbe4b7ddc1b351ef961425"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Implement feature"
                    },
                    "desc": {
                        "type": "string",
                        "title": "Description",
                        "example": "Add the new export option."
                    },
                    "closed": {
                        "type": "boolean",
                        "title": "Closed (Archived)",
                        "example": false
                    },
                    "idBoard": {
                        "type": "string",
                        "title": "Board ID",
                        "example": "5abbe4b7ddc1b351ef961420"
                    },
                    "idList": {
                        "type": "string",
                        "title": "List ID",
                        "example": "5abbe4b7ddc1b351ef961430"
                    },
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://trello.com/c/abc12345/1-implement-feature"
                    },
                    "shortUrl": {
                        "type": "string",
                        "title": "Short URL",
                        "example": "https://trello.com/c/abc12345"
                    },
                    "due": {
                        "type": "string",
                        "title": "Due Date",
                        "example": "2024-02-01T17:00:00.000Z"
                    },
                    "dueComplete": {
                        "type": "boolean",
                        "title": "Due Complete",
                        "example": false
                    }
                }
            }
        },
        {
            "name": "notFound",
            "schema": {
                "type": "object",
                "properties": {
                    "boardCardId": {
                        "type": "string",
                        "title": "Card ID",
                        "example": "5abbe4b7ddc1b351ef961425"
                    }
                }
            }
        }
    ]
}
