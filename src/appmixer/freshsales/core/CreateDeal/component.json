{
    "name": "appmixer.freshsales.core.CreateDeal",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a sales deal and optionally associate contacts/accounts and custom fields.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:freshsales"
    },
    "quota": {
        "manager": "appmixer:freshsales",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "deal_name": {
                        "type": "string"
                    },
                    "deal_amount": {
                        "type": "number"
                    },
                    "currency_code": {
                        "type": "string"
                    },
                    "expected_close": {
                        "type": "string",
                        "format": "date"
                    },
                    "stage_id": {
                        "type": "integer"
                    },
                    "owner_id": {
                        "type": "integer"
                    },
                    "sales_account_id": {
                        "type": "integer"
                    },
                    "sales_account_name": {
                        "type": "string"
                    },
                    "contacts_list": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "custom_fields": {
                        "type": "object"
                    }
                },
                "required": [
                    "deal_name",
                    "deal_amount"
                ]
            },
            "inspector": {
                "inputs": {
                    "deal_name": {
                        "type": "text",
                        "label": "Deal Name",
                        "tooltip": "Name of the deal.",
                        "index": 0
                    },
                    "deal_amount": {
                        "type": "number",
                        "label": "Deal Amount",
                        "tooltip": "Value of the deal.",
                        "index": 1
                    },
                    "currency_code": {
                        "type": "text",
                        "label": "Currency Code",
                        "tooltip": "Currency code (e.g., USD).",
                        "index": 2
                    },
                    "expected_close": {
                        "type": "date-time",
                        "label": "Expected Close Date",
                        "config": {
                            "enableTime": false
                        },
                        "tooltip": "Expected close date.",
                        "index": 3
                    },
                    "stage_id": {
                        "type": "number",
                        "label": "Stage ID",
                        "tooltip": "Pipeline stage ID.",
                        "index": 4
                    },
                    "owner_id": {
                        "type": "number",
                        "label": "Owner/Agent ID",
                        "tooltip": "Owner/agent user ID to assign the deal.",
                        "index": 5
                    },
                    "sales_account_id": {
                        "type": "number",
                        "label": "Sales Account ID",
                        "tooltip": "Existing sales account ID to associate with the deal.",
                        "index": 6
                    },
                    "sales_account_name": {
                        "type": "text",
                        "label": "Sales Account Name",
                        "tooltip": "Sales account name (used if creating/associating by name).",
                        "index": 7
                    },
                    "contacts_list": {
                        "type": "text",
                        "label": "Contacts List",
                        "tooltip": "Array of contact IDs to associate with the deal (comma-separated).",
                        "index": 8
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "tooltip": "Tags to assign to the deal (comma-separated).",
                        "index": 9
                    },
                    "custom_fields": {
                        "type": "text",
                        "label": "Custom Fields",
                        "tooltip": "JSON object containing custom field key-value pairs.",
                        "index": 10
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Deal ID"
                    },
                    "name": {
                        "type": "string",
                        "title": "Deal Name"
                    },
                    "amount": {
                        "type": "string",
                        "title": "Amount"
                    },
                    "base_currency_amount": {
                        "type": "string",
                        "title": "Base Currency Amount"
                    },
                    "currency_code": {
                        "type": "string",
                        "title": "Currency Code"
                    },
                    "expected_close": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Expected Close"
                    },
                    "closed_date": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Closed Date"
                    },
                    "stage_updated_time": {
                        "type": "string",
                        "title": "Stage Updated Time"
                    },
                    "custom_field": {
                        "type": "object",
                        "title": "Custom Fields"
                    },
                    "probability": {
                        "type": "integer",
                        "title": "Probability"
                    },
                    "updated_at": {
                        "type": "string",
                        "title": "Updated At"
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At"
                    },
                    "deal_pipeline_id": {
                        "type": "integer",
                        "title": "Deal Pipeline ID"
                    },
                    "deal_stage_id": {
                        "type": "integer",
                        "title": "Deal Stage ID"
                    },
                    "age": {
                        "type": "integer",
                        "title": "Age"
                    },
                    "links": {
                        "type": "object",
                        "title": "Links"
                    },
                    "recent_note": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Recent Note"
                    },
                    "completed_sales_sequences": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Completed Sales Sequences"
                    },
                    "active_sales_sequences": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Active Sales Sequences"
                    },
                    "web_form_id": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Web Form ID"
                    },
                    "upcoming_activities_time": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Upcoming Activities Time"
                    },
                    "collaboration": {
                        "type": "object",
                        "title": "Collaboration"
                    },
                    "last_assigned_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Last Assigned At"
                    },
                    "last_contacted_sales_activity_mode": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Last Contacted Sales Activity Mode"
                    },
                    "last_contacted_via_sales_activity": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Last Contacted Via Sales Activity"
                    },
                    "expected_deal_value": {
                        "type": "string",
                        "title": "Expected Deal Value"
                    },
                    "is_deleted": {
                        "type": "boolean",
                        "title": "Is Deleted"
                    },
                    "team_user_ids": {
                        "type": "array",
                        "title": "Team User IDs"
                    },
                    "avatar": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Avatar"
                    },
                    "fc_widget_collaboration": {
                        "type": "object",
                        "title": "FC Widget Collaboration"
                    },
                    "forecast_category": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "title": "Forecast Category"
                    },
                    "deal_prediction": {
                        "type": "integer",
                        "title": "Deal Prediction"
                    },
                    "deal_prediction_last_updated_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Deal Prediction Last Updated At"
                    },
                    "record_type_id": {
                        "type": "string",
                        "title": "Record Type ID"
                    },
                    "freddy_forecast_metrics": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Freddy Forecast Metrics"
                    },
                    "last_deal_prediction": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Last Deal Prediction"
                    },
                    "has_products": {
                        "type": "boolean",
                        "title": "Has Products"
                    },
                    "products": {
                        "type": "array",
                        "title": "Products"
                    },
                    "deal_price_adjustments": {
                        "type": "array",
                        "title": "Deal Price Adjustments"
                    },
                    "rotten_days": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Rotten Days"
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "title": "Tags"
                    },
                    "creater_id": {
                        "type": "integer",
                        "title": "Creator ID"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,PD94"
}
