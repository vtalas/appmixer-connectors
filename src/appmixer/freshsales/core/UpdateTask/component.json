{
    "name": "appmixer.freshsales.core.UpdateTask",
    "description": "Update an existing task by ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:freshsales"
    },
    "quota": {
        "manager": "appmixer:freshsales",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "due_date": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "task_type": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "owner_id": {
                        "type": "integer"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "label": "Task ID",
                        "tooltip": "The ID of the task to update.",
                        "index": 1
                    },
                    "title": {
                        "type": "text",
                        "label": "Title",
                        "tooltip": "Task title.",
                        "index": 2
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "tooltip": "Task description.",
                        "index": 3
                    },
                    "due_date": {
                        "type": "date-time",
                        "label": "Due Date",
                        "tooltip": "Due date and time for the task.",
                        "index": 4
                    },
                    "task_type": {
                        "type": "text",
                        "label": "Task Type",
                        "tooltip": "Type of task.",
                        "index": 5
                    },
                    "priority": {
                        "type": "select",
                        "label": "Priority",
                        "tooltip": "Priority level of the task.",
                        "index": 6,
                        "options": [
                            {
                                "label": "None",
                                "value": 0
                            },
                            {
                                "label": "Low",
                                "value": 1
                            },
                            {
                                "label": "Medium",
                                "value": 2
                            },
                            {
                                "label": "High",
                                "value": 3
                            }
                        ]
                    },
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "tooltip": "Status of the task.",
                        "index": 7,
                        "options": [
                            {
                                "label": "Open",
                                "value": 0
                            },
                            {
                                "label": "Completed",
                                "value": 1
                            }
                        ]
                    },
                    "owner_id": {
                        "type": "number",
                        "label": "Owner ID",
                        "tooltip": "User ID of the task owner.",
                        "index": 8
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "ID",
                    "value": "id"
                },
                {
                    "label": "Title",
                    "value": "title"
                },
                {
                    "label": "Description",
                    "value": "description"
                },
                {
                    "label": "Status",
                    "value": "status"
                },
                {
                    "label": "Due Date",
                    "value": "due_date"
                },
                {
                    "label": "Completed Date",
                    "value": "completed_date"
                },
                {
                    "label": "Task Type ID",
                    "value": "task_type_id"
                },
                {
                    "label": "Owner ID",
                    "value": "owner_id"
                },
                {
                    "label": "Outcome ID",
                    "value": "outcome_id"
                },
                {
                    "label": "Creator ID",
                    "value": "creater_id"
                },
                {
                    "label": "Updater ID",
                    "value": "updater_id"
                },
                {
                    "label": "Is LinkedIn Type",
                    "value": "is_linkedin_type"
                },
                {
                    "label": "Has Multiple Emails",
                    "value": "has_multiple_emails"
                },
                {
                    "label": "Targetables",
                    "value": "targetables"
                },
                {
                    "label": "Targetables With Email",
                    "value": "targetables_with_email"
                },
                {
                    "label": "User IDs",
                    "value": "user_ids"
                },
                {
                    "label": "Targetable",
                    "value": "targetable"
                },
                {
                    "label": "Created At",
                    "value": "created_at"
                },
                {
                    "label": "Updated At",
                    "value": "updated_at"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,PD94"
}