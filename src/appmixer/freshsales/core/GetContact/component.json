{
    "name": "appmixer.freshsales.core.GetContact",
    "description": "Retrieve a contact by ID with optional embedded resources.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:freshsales"
    },
    "quota": {
        "manager": "appmixer:freshsales",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "include": {
                        "type": "string"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "number",
                        "label": "Contact ID",
                        "tooltip": "The unique identifier of the contact to retrieve.",
                        "index": 1
                    },
                    "include": {
                        "type": "text",
                        "label": "Include",
                        "tooltip": "Comma-separated list of associated resources to embed: owner, creater, updater, source, territory, tasks, appointments, notes, sales_accounts.",
                        "index": 2
                    }
                }
            }
        }
    ],
