{
    "name": "appmixer.freshsales.core.ListContactsbyView",
    "description": "Retrieve contacts by a saved view with optional sorting.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:freshsales"
    },
    "quota": {
        "manager": "appmixer:freshsales",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "view_id": {
                        "type": "integer",
                        "description": "The ID of the view/filter to use for fetching contacts"
                    },
                    "sort": {
                        "type": "string",
                        "description": "The contact field to sort by",
                        "enum": [
                            "lead_score",
                            "created_at",
                            "updated_at",
                            "open_deals_amount",
                            "last_contacted"
                        ]
                    },
                    "sort_type": {
                        "type": "string",
                        "description": "Sort contacts in ascending or descending order",
                        "enum": [
                            "asc",
                            "desc"
                        ]
                    }
                },
                "required": [
                    "view_id"
                ]
            },
            "inspector": {
                "inputs": {
                    "view_id": {
                        "type": "number",
                        "index": 0,
                        "label": "View ID",
                        "tooltip": "The ID of the view/filter to use for fetching contacts"
                    },
                    "sort": {
                        "type": "select",
                        "index": 1,
                        "label": "Sort By",
                        "tooltip": "The contact field to sort by",
                        "options": [
                            {
                                "label": "Lead Score",
                                "value": "lead_score"
                            },
                            {
                                "label": "Created At",
                                "value": "created_at"
                            },
                            {
                                "label": "Updated At",
                                "value": "updated_at"
                            },
                            {
                                "label": "Open Deals Amount",
                                "value": "open_deals_amount"
                            },
                            {
                                "label": "Last Contacted",
                                "value": "last_contacted"
                            }
                        ]
                    },
                    "sort_type": {
                        "type": "select",
                        "index": 2,
                        "label": "Sort Order",
                        "tooltip": "Sort contacts in ascending or descending order",
                        "options": [
                            {
                                "label": "Ascending",
                                "value": "asc"
                            },
                            {
                                "label": "Descending",
                                "value": "desc"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "contacts.0.id"
                },
                {
                    "label": "Partial",
                    "value": "contacts.0.partial"
                },
                {
                    "label": "Job Title",
                    "value": "contacts.0.job_title"
                },
                {
                    "label": "Lead Score",
                    "value": "contacts.0.lead_score"
                },
                {
                    "label": "Email",
                    "value": "contacts.0.email"
                },
                {
                    "label": "Work Number",
                    "value": "contacts.0.work_number"
                },
                {
                    "label": "Mobile Number",
                    "value": "contacts.0.mobile_number"
                },
                {
                    "label": "Open Deals Amount",
                    "value": "contacts.0.open_deals_amount"
                },
                {
                    "label": "Display Name",
                    "value": "contacts.0.display_name"
                },
                {
                    "label": "Avatar",
                    "value": "contacts.0.avatar"
                },
                {
                    "label": "Last Contacted Mode",
                    "value": "contacts.0.last_contacted_mode"
                },
                {
                    "label": "Last Contacted",
                    "value": "contacts.0.last_contacted"
                },
                {
                    "label": "First Name",
                    "value": "contacts.0.first_name"
                },
                {
                    "label": "Last Name",
                    "value": "contacts.0.last_name"
                },
                {
                    "label": "City",
                    "value": "contacts.0.city"
                },
                {
                    "label": "Country",
                    "value": "contacts.0.country"
                },
                {
                    "label": "Created At",
                    "value": "contacts.0.created_at"
                },
                {
                    "label": "Updated At",
                    "value": "contacts.0.updated_at"
                },
                {
                    "label": "Total Contacts",
                    "value": "meta.total"
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}