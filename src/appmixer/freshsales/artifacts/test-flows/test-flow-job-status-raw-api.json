{
    "name": "E2E Freshsales - Job Status and Raw API",
    "description": "End-to-end test for Freshsales connector - tests CreateContact, GetJobStatus, RawApiCall, and DeleteContact",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "firstName",
                                                "text": "E2ETest"
                                            },
                                            {
                                                "type": "text",
                                                "name": "lastName",
                                                "text": "FreshsalesJobStatus"
                                            },
                                            {
                                                "type": "text",
                                                "name": "email",
                                                "text": "e2e.freshsales.jobstatus@appmixer-test.invalid"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-contact": {
            "type": "appmixer.freshsales.core.CreateContact",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "first_name": {
                                        "var-first-name": {
                                            "variable": "$.set-variables.out.firstName",
                                            "functions": []
                                        }
                                    },
                                    "last_name": {
                                        "var-last-name": {
                                            "variable": "$.set-variables.out.lastName",
                                            "functions": []
                                        }
                                    },
                                    "email": {
                                        "var-email": {
                                            "variable": "$.set-variables.out.email",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "first_name": "{{{var-first-name}}}",
                                    "last_name": "{{{var-last-name}}}",
                                    "email": "{{{var-email}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-contact": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-contact": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "contact-id": {
                                            "variable": "$.create-contact.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{contact-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "raw-api-call": {
            "type": "appmixer.freshsales.core.RawApiCall",
            "x": 640,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-contact": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-contact": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "method": {},
                                    "body": {
                                        "var-contact-email": {
                                            "variable": "$.set-variables.out.email",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "method": "UpsertContact",
                                    "body": "{\"unique_identifier\": {\"emails\": \"{{{var-contact-email}}}\"}, \"contact\": {\"first_name\": \"E2ETest\", \"last_name\": \"FreshsalesJobStatus\"}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-raw-api": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "raw-api-call": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "raw-api-call": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "job-id-field": {
                                            "variable": "$.raw-api-call.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{job-id-field}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-job-status": {
            "type": "appmixer.freshsales.core.GetJobStatus",
            "x": 832,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "raw-api-call": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "raw-api-call": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "id": {
                                        "var-job-id": {
                                            "variable": "$.raw-api-call.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "id": "{{{var-job-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-job-status": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-job-status": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-job-status": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "job-status-field": {
                                            "variable": "$.get-job-status.out.status",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{job-status-field}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1392,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-create": ["out"],
                    "assert-raw-api": ["out"],
                    "assert-job-status": ["out"]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-contact": {
            "type": "appmixer.freshsales.core.DeleteContact",
            "x": 1584,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "id": {
                                        "var-contact-id": {
                                            "variable": "$.create-contact.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "id": "{{{var-contact-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1776,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "delete-contact": ["out"]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "delete-contact": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E Freshsales - Job Status and Raw API",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
