{
    "name": "E2E Freshsales - Task Lifecycle",
    "description": "End-to-end test for Freshsales connector - tests full task lifecycle: Create, Get, Update, Delete",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 256,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "taskTitle",
                                                "text": "E2E Test Task"
                                            },
                                            {
                                                "type": "text",
                                                "name": "updatedTaskTitle",
                                                "text": "E2E Test Task Updated"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-task": {
            "type": "appmixer.freshsales.core.CreateTask",
            "x": 448,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "title": {
                                        "var-task-title": {
                                            "variable": "$.set-variables.out.taskTitle",
                                            "functions": []
                                        }
                                    },
                                    "description": {},
                                    "task_type": {},
                                    "priority": {},
                                    "status": {}
                                },
                                "lambda": {
                                    "title": "{{{var-task-title}}}",
                                    "description": "Created by E2E test",
                                    "task_type": "Follow-up",
                                    "priority": "Medium",
                                    "status": "Open"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-task": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "created-task-id": {
                                            "variable": "$.create-task.out.id",
                                            "functions": []
                                        },
                                        "created-task-title": {
                                            "variable": "$.create-task.out.title",
                                            "functions": []
                                        },
                                        "expected-title": {
                                            "variable": "$.set-variables.out.taskTitle",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{created-task-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{created-task-title}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-title}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-task": {
            "type": "appmixer.freshsales.core.GetTask",
            "x": 640,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-task": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "id": {
                                        "var-task-id": {
                                            "variable": "$.create-task.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "id": "{{{var-task-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-get": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-task": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "got-task-id": {
                                            "variable": "$.get-task.out.id",
                                            "functions": []
                                        },
                                        "got-task-title": {
                                            "variable": "$.get-task.out.title",
                                            "functions": []
                                        },
                                        "expected-title": {
                                            "variable": "$.set-variables.out.taskTitle",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{got-task-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{got-task-title}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-title}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "update-task": {
            "type": "appmixer.freshsales.core.UpdateTask",
            "x": 832,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-task": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "id": {
                                        "var-task-id": {
                                            "variable": "$.create-task.out.id",
                                            "functions": []
                                        }
                                    },
                                    "title": {
                                        "var-updated-title": {
                                            "variable": "$.set-variables.out.updatedTaskTitle",
                                            "functions": []
                                        }
                                    },
                                    "status": {}
                                },
                                "lambda": {
                                    "id": "{{{var-task-id}}}",
                                    "title": "{{{var-updated-title}}}",
                                    "status": 1
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-update": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "update-task": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "update-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "updated-task-id": {
                                            "variable": "$.update-task.out.id",
                                            "functions": []
                                        },
                                        "updated-task-title": {
                                            "variable": "$.update-task.out.title",
                                            "functions": []
                                        },
                                        "expected-updated-title": {
                                            "variable": "$.set-variables.out.updatedTaskTitle",
                                            "functions": []
                                        },
                                        "updated-task-status": {
                                            "variable": "$.update-task.out.status",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{updated-task-id}}}",
                                                "assertion": "notEmpty"
                                            },
                                            {
                                                "field": "{{{updated-task-title}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-updated-title}}}"
                                            },
                                            {
                                                "field": "{{{updated-task-status}}}",
                                                "assertion": "equal",
                                                "expected": "1"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1392,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-create": ["out"],
                    "assert-get": ["out"],
                    "assert-update": ["out"]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-task": {
            "type": "appmixer.freshsales.core.DeleteTask",
            "x": 1584,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "id": {
                                        "var-delete-id": {
                                            "variable": "$.create-task.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "id": "{{{var-delete-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-e2e-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1776,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "delete-task": ["out"]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "delete-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E Freshsales - Task Lifecycle",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
