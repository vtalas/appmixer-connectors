{
    "name": "E2E Axiom - Dataset Lifecycle",
    "description": "End-to-end test for Axiom connector - tests Dataset CRUD operations (Create, Get, Update, Delete)",
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 64,
            "y": 16,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 272,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "datasetName",
                                                "text": "e2e-test-dataset-{{{g_timestamp()}}}"
                                            },
                                            {
                                                "type": "text",
                                                "name": "datasetDescription",
                                                "text": "E2E Test Dataset Description"
                                            },
                                            {
                                                "type": "text",
                                                "name": "updatedDescription",
                                                "text": "E2E Test Dataset Description Updated"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-dataset": {
            "type": "appmixer.axiom.datasets.CreateDataset",
            "x": 464,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "name": {
                                        "var-dataset-name": {
                                            "variable": "$.set-variables.out.datasetName",
                                            "functions": []
                                        }
                                    },
                                    "description": {
                                        "var-dataset-description": {
                                            "variable": "$.set-variables.out.datasetDescription",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "name": "{{{var-dataset-name}}}",
                                    "description": "{{{var-dataset-description}}}",
                                    "kind": "axiom:events:v1"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 16,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-dataset": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-dataset": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-create-id": {
                                            "variable": "$.create-dataset.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-create-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-dataset": {
            "type": "appmixer.axiom.datasets.GetDataset",
            "x": 656,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-dataset": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-dataset": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "datasetId": {
                                        "var-dataset-id": {
                                            "variable": "$.create-dataset.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "datasetId": "{{{var-dataset-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-get": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-dataset": [
                        "out"
                    ],
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-dataset": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-get-description": {
                                            "variable": "$.get-dataset.out.description",
                                            "functions": []
                                        },
                                        "expected-get-description": {
                                            "variable": "$.set-variables.out.datasetDescription",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-get-description}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-get-description}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "update-dataset": {
            "type": "appmixer.axiom.datasets.UpdateDataset",
            "x": 848,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-dataset": [
                        "out"
                    ],
                    "create-dataset": [
                        "out"
                    ],
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-dataset": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "datasetId": {
                                        "var-update-dataset-id": {
                                            "variable": "$.create-dataset.out.id",
                                            "functions": []
                                        }
                                    },
                                    "description": {
                                        "var-updated-description": {
                                            "variable": "$.set-variables.out.updatedDescription",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "datasetId": "{{{var-update-dataset-id}}}",
                                    "description": "{{{var-updated-description}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-update": {
            "type": "appmixer.utils.test.Assert",
            "x": 1200,
            "y": 272,
            "version": "1.0.0",
            "source": {
                "in": {
                    "update-dataset": [
                        "out"
                    ],
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "update-dataset": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-update-description": {
                                            "variable": "$.update-dataset.out.description",
                                            "functions": []
                                        },
                                        "expected-updated-description": {
                                            "variable": "$.set-variables.out.updatedDescription",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-update-description}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-updated-description}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1392,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-create": [
                        "out"
                    ],
                    "assert-get": [
                        "out"
                    ],
                    "assert-update": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-dataset": {
            "type": "appmixer.axiom.datasets.DeleteDataset",
            "x": 1616,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ],
                    "create-dataset": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "datasetId": {
                                        "var-delete-dataset-id": {
                                            "variable": "$.create-dataset.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "datasetId": "{{{var-delete-dataset-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1808,
            "y": 144,
            "version": "1.0.0",
            "source": {
                "in": {
                    "delete-dataset": [
                        "out"
                    ],
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "delete-dataset": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "lades@client.io",
                                    "testCase": "E2E Axiom - Dataset Lifecycle",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}