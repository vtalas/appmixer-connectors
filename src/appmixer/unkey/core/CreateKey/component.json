{
    "name": "appmixer.unkey.core.CreateKey",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new API key in Unkey. You can specify properties like prefix, metadata, rate limits, credits, and expiration.",
    "version": "1.0.1",
    "auth": {
        "service": "appmixer:unkey"
    },
    "quota": {
        "manager": "appmixer:unkey",
        "resources": "keys.create",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "apiId": {
                        "type": "string"
                    },
                    "prefix": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "byteLength": {
                        "type": "integer"
                    },
                    "externalId": {
                        "type": "string"
                    },
                    "meta": {
                        "type": "string"
                    },
                    "roles": {
                        "type": "string"
                    },
                    "permissions": {
                        "type": "string"
                    },
                    "expires": {
                        "type": "integer"
                    },
                    "ratelimits": {
                        "type": "string"
                    },
                    "enabled": {
                        "type": "boolean"
                    },
                    "creditsRemaining": {
                        "type": "integer"
                    },
                    "refillInterval": {
                        "type": "string"
                    },
                    "refillAmount": {
                        "type": "integer"
                    },
                    "refillDay": {
                        "type": "integer"
                    }
                },
                "required": ["apiId"]
            },
            "inspector": {
                "inputs": {
                    "apiId": {
                        "type": "text",
                        "label": "API ID",
                        "index": 1,
                        "tooltip": "The ID of the API this key belongs to"
                    },
                    "prefix": {
                        "type": "text",
                        "label": "Key Prefix",
                        "index": 2,
                        "tooltip": "Optional prefix for the key (e.g., 'sk')"
                    },
                    "name": {
                        "type": "text",
                        "label": "Key Name",
                        "index": 3,
                        "tooltip": "A name to identify the key"
                    },
                    "byteLength": {
                        "type": "number",
                        "label": "Byte Length",
                        "index": 4,
                        "tooltip": "Length of the key in bytes (16-255, default: 16). Higher values increase security."
                    },
                    "externalId": {
                        "type": "text",
                        "label": "External ID",
                        "index": 5,
                        "tooltip": "Your system's identifier for the user/entity. Returned during verification for user identification."
                    },
                    "meta": {
                        "type": "textarea",
                        "label": "Metadata (JSON)",
                        "index": 6,
                        "tooltip": "JSON object with custom metadata returned during verification. Avoid sensitive data."
                    },
                    "roles": {
                        "type": "textarea",
                        "label": "Roles (JSON array)",
                        "index": 7,
                        "tooltip": "JSON array of role names to assign (e.g., [\"admin\", \"editor\"]). Roles must exist in workspace."
                    },
                    "permissions": {
                        "type": "textarea",
                        "label": "Permissions (JSON array)",
                        "index": 8,
                        "tooltip": "JSON array of permissions (e.g., [\"documents.read\", \"documents.write\"]). Supports wildcards."
                    },
                    "expires": {
                        "type": "number",
                        "label": "Expires (Unix timestamp ms)",
                        "index": 9,
                        "tooltip": "Unix timestamp in milliseconds when key expires. Omit for permanent keys."
                    },
                    "ratelimits": {
                        "type": "textarea",
                        "label": "Rate Limits (JSON array)",
                        "index": 10,
                        "tooltip": "JSON array of rate limit objects with name, limit, duration (ms), and autoApply fields."
                    },
                    "enabled": {
                        "type": "toggle",
                        "label": "Enabled",
                        "index": 11,
                        "defaultValue": true,
                        "tooltip": "Whether the key is active immediately upon creation"
                    },
                    "creditsRemaining": {
                        "type": "number",
                        "label": "Credits Remaining",
                        "index": 12,
                        "tooltip": "Number of credits for this key. Omit for unlimited usage. Credits are consumed during key verification."
                    },
                    "refillInterval": {
                        "type": "select",
                        "label": "Refill Interval",
                        "index": 13,
                        "options": [
                            { "label": "Daily", "value": "daily" },
                            { "label": "Monthly", "value": "monthly" }
                        ],
                        "tooltip": "How often credits are automatically refilled. Requires Credits Remaining to be set."
                    },
                    "refillAmount": {
                        "type": "number",
                        "label": "Refill Amount",
                        "index": 14,
                        "tooltip": "Number of credits to add during each refill cycle."
                    },
                    "refillDay": {
                        "type": "number",
                        "label": "Refill Day",
                        "index": 15,
                        "tooltip": "Day of the month for monthly refills (1-31). Only used when Refill Interval is 'monthly'."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Key ID", "value": "keyId" },
                { "label": "Key", "value": "key" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
