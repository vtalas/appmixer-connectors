{
    "name": "appmixer.apify.core.GetListofActors",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a list of actors available in the Apify service.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:apify"
    },
    "quota": {
        "manager": "appmixer:apify",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "token": {
                        "title": "API Token",
                        "type": "string",
                        "description": "Your Apify API token for authentication."
                    },
                    "limit": {
                        "title": "Limit",
                        "type": "integer",
                        "description": "The maximum number of actors to return. Default is 1000."
                    },
                    "offset": {
                        "title": "Offset",
                        "type": "integer",
                        "description": "The number of actors to skip before starting to return results."
                    },
                    "desc": {
                        "title": "Sort Order",
                        "type": "boolean",
                        "description": "Set to true to sort results in descending order by creation date."
                    },
                    "my": {
                        "title": "My Actors Only",
                        "type": "boolean",
                        "description": "Set to true to return only actors created by the user."
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "token": {
                        "type": "text",
                        "tooltip": "Your Apify API token for authentication.",
                        "label": "Token",
                        "index": 0
                    },
                    "limit": {
                        "type": "number",
                        "tooltip": "The maximum number of actors to return. Default is 1000.",
                        "label": "Limit",
                        "index": 1
                    },
                    "offset": {
                        "type": "number",
                        "tooltip": "The number of actors to skip before starting to return results.",
                        "label": "Offset",
                        "index": 2
                    },
                    "desc": {
                        "type": "toggle",
                        "tooltip": "Set to true to sort results in descending order by creation date.",
                        "label": "Desc",
                        "index": 3
                    },
                    "my": {
                        "type": "toggle",
                        "tooltip": "Set to true to return only actors created by the user.",
                        "label": "My",
                        "index": 4
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 2,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/apify/core/GetListofActors?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}