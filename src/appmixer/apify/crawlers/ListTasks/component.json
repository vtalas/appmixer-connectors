{
    "name": "appmixer.apify.core.ListTasks",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a list of tasks from your Apify account.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:apify"
    },
    "quota": {
        "manager": "appmixer:apify",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in"
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Data",
                    "value": "data",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "Data.Id"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Data.Name"
                                },
                                "userId": {
                                    "type": "string",
                                    "title": "Data.User Id"
                                },
                                "createdAt": {
                                    "type": "string",
                                    "title": "Data.Created At"
                                },
                                "modifiedAt": {
                                    "type": "string",
                                    "title": "Data.Modified At"
                                },
                                "actId": {
                                    "type": "string",
                                    "title": "Data.Act Id"
                                },
                                "options": {
                                    "type": "object",
                                    "properties": {
                                        "build": {
                                            "type": "string",
                                            "title": "Data.Options.Build"
                                        },
                                        "timeoutSecs": {
                                            "type": "number",
                                            "title": "Data.Options.Timeout Secs"
                                        },
                                        "memoryMbytes": {
                                            "type": "number",
                                            "title": "Data.Options.Memory Mbytes"
                                        }
                                    },
                                    "title": "Data.Options"
                                },
                                "stats": {
                                    "type": "object",
                                    "properties": {
                                        "totalRuns": {
                                            "type": "number",
                                            "title": "Data.Stats.Total Runs"
                                        },
                                        "successRuns": {
                                            "type": "number",
                                            "title": "Data.Stats.Success Runs"
                                        },
                                        "failedRuns": {
                                            "type": "number",
                                            "title": "Data.Stats.Failed Runs"
                                        },
                                        "lastRunStatus": {
                                            "type": "string",
                                            "title": "Data.Stats.Last Run Status"
                                        }
                                    },
                                    "title": "Data.Stats"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Total",
                    "value": "total",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Offset",
                    "value": "offset",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Count",
                    "value": "count",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Limit",
                    "value": "limit",
                    "schema": {
                        "type": "number"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}