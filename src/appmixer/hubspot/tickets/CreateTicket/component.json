{
    "name": "appmixer.hubspot.tickets.CreateTicket",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Create a new ticket.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "subject": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "pipeline": {
                        "type": "string"
                    },
                    "stage": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "string"
                    },
                    "ownerId": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string"
                    }
                },
                "required": [
                    "subject"
                ]
            },
            "inspector": {
                "inputs": {
                    "subject": {
                        "type": "text",
                        "label": "Subject",
                        "tooltip": "The ticket name / subject.",
                        "index": 1
                    },
                    "content": {
                        "type": "textarea",
                        "label": "Description",
                        "tooltip": "The main description / content of the ticket.",
                        "index": 2
                    },
                    "pipeline": {
                        "type": "text",
                        "label": "Pipeline",
                        "tooltip": "The ID of the ticket pipeline. Defaults to the support pipeline (0).",
                        "defaultValue": "0",
                        "index": 3
                    },
                    "stage": {
                        "type": "text",
                        "label": "Pipeline Stage",
                        "tooltip": "The ID of the stage within the pipeline. Defaults to the first stage (1 = New).",
                        "defaultValue": "1",
                        "index": 4
                    },
                    "priority": {
                        "type": "select",
                        "label": "Priority",
                        "tooltip": "The priority of the ticket.",
                        "options": [
                            {
                                "label": "Low",
                                "value": "LOW"
                            },
                            {
                                "label": "Medium",
                                "value": "MEDIUM"
                            },
                            {
                                "label": "High",
                                "value": "HIGH"
                            }
                        ],
                        "index": 5
                    },
                    "ownerId": {
                        "type": "text",
                        "label": "Owner ID",
                        "tooltip": "The ID of the HubSpot owner (user) the ticket is assigned to.",
                        "index": 6
                    },
                    "category": {
                        "type": "text",
                        "label": "Category",
                        "tooltip": "The category of the ticket (e.g. GENERAL_INQUIRY, TECHNICAL_ISSUE, BILLING_ISSUE).",
                        "index": 7
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "ticket",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Ticket ID",
                        "example": "1846987684"
                    },
                    "subject": {
                        "type": "string",
                        "title": "Subject",
                        "example": "Cannot log in"
                    },
                    "content": {
                        "type": "string",
                        "title": "Content",
                        "example": "The user is unable to log in to the portal."
                    },
                    "pipeline": {
                        "type": "string",
                        "title": "Pipeline",
                        "example": "0"
                    },
                    "stage": {
                        "type": "string",
                        "title": "Stage",
                        "example": "1"
                    },
                    "priority": {
                        "type": "string",
                        "title": "Priority",
                        "example": "HIGH"
                    },
                    "ownerId": {
                        "type": "string",
                        "title": "Owner ID",
                        "example": "41629779"
                    },
                    "category": {
                        "type": "string",
                        "title": "Category",
                        "example": "GENERAL_INQUIRY"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2024-01-15T09:30:00.000Z"
                    },
                    "updatedAt": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2024-01-16T11:45:00.000Z"
                    }
                }
            }
        }
    ],
    "dependencies": {
        "service": "1.0.1"
    }
}
