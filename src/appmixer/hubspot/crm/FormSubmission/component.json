{
    "name": "appmixer.hubspot.crm.FormSubmission",
    "icon": "data:image/svg+xml;base64,",
    "description": "Triggers when a form is submitted in HubSpot.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:hubspot"
    },
    "quota": {
        "manager": "appmixer:hubspot",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "properties": {
                "formId": { "type": "string" }
            },
            "required": ["formId"]
        },
        "inspector": {
            "inputs": {
                "formId": {
                    "type": "text",
                    "label": "Form ID",
                    "tooltip": "The GUID of the HubSpot form to watch for new submissions.",
                    "index": 1
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "submission",
            "options": [
                {
                    "label": "Form ID",
                    "value": "formId",
                    "schema": { "type": "string" }
                },
                {
                    "label": "Submitted At",
                    "value": "submittedAt",
                    "schema": { "type": "string" }
                },
                {
                    "label": "Page URL",
                    "value": "pageUrl",
                    "schema": { "type": "string" }
                },
                {
                    "label": "Page Name",
                    "value": "pageName",
                    "schema": { "type": "string" }
                },
                {
                    "label": "Portal ID",
                    "value": "portalId",
                    "schema": { "type": "number" }
                },
                {
                    "label": "Values",
                    "value": "values",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": { "type": "string" },
                                "value": { "type": "string" }
                            }
                        }
                    }
                }
            ]
        }
    ]
}
