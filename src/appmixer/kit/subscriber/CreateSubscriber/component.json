{
    "name": "appmixer.kit.subscriber.CreateSubscriber",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new subscriber or update an existing one based on a unique email (upsert behavior).",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:kit"
    },
    "quota": {
        "manager": "appmixer:kit",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "customFields": {
                        "type": "object"
                    }
                },
                "required": ["email"]
            },
            "inspector": {
                "inputs": {
                    "email": {
                        "type": "text",
                        "tooltip": "Subscriber's email address.",
                        "label": "Email",
                        "index": 0
                    },
                    "firstName": {
                        "type": "text",
                        "tooltip": "Subscriber's first name.",
                        "label": "First Name",
                        "index": 1
                    },
                    "lastName": {
                        "type": "text",
                        "tooltip": "Subscriber's last name.",
                        "label": "Last Name",
                        "index": 2
                    },
                    "customFields": {
                        "type": "text",
                        "tooltip": "Optional key/value pairs for custom subscriber information (JSON format).",
                        "label": "Custom Fields",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Email",
                    "value": "email",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "First Name",
                    "value": "firstName",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Last Name",
                    "value": "lastName",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Created At",
                    "value": "createdAt",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}
