{
    "name": "appmixer.github.project.AddProjectItem",
    "label": "Add Project Item",
    "description": "Add an existing GitHub issue or pull request to a project",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "project"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": {
                        "type": "string",
                        "title": "Project ID",
                        "description": "The node ID of the GitHub project"
                    },
                    "contentId": {
                        "type": "string",
                        "title": "Content ID",
                        "description": "The node ID of the issue or pull request to add"
                    }
                },
                "required": ["projectId", "contentId"]
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "text",
                        "index": 1,
                        "tooltip": "The project ID from the GitHub project URL or ListProjects component"
                    },
                    "contentId": {
                        "type": "text",
                        "index": 2,
                        "tooltip": "The node ID of the issue or pull request (can be found in GitHub API responses)"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Item ID",
                    "value": "itemId"
                },
                {
                    "label": "Success",
                    "value": "success"
                }
            ]
        }
    ],
    "quota": {
        "manager": "appmixer:github",
        "resources": ["github.api"],
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png"
}