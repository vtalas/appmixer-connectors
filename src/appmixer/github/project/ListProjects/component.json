{
    "name": "appmixer.github.project.ListProjects",
    "label": "List Projects",
    "description": "List all GitHub projects accessible to the authenticated user (both personal and organization projects)",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "read:project"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "organizationLogin": {
                        "type": "string",
                        "title": "Organization Login",
                        "description": "Organization login name (leave empty to list user projects)"
                    },
                    "limit": {
                        "type": "number",
                        "title": "Limit",
                        "description": "Maximum number of projects to return (default: 20, max: 100)",
                        "default": 20,
                        "minimum": 1,
                        "maximum": 100
                    }
                },
                "required": []
            },
            "inspector": {
                "inputs": {
                    "organizationLogin": {
                        "type": "text",
                        "index": 1,
                        "tooltip": "Enter organization name to list organization projects, or leave empty for personal projects"
                    },
                    "limit": {
                        "type": "number",
                        "index": 2,
                        "tooltip": "Number of projects to return (1-100)",
                        "defaultValue": 20
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Projects",
                    "value": "projects",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "Project ID"
                                },
                                "title": {
                                    "type": "string",
                                    "title": "Title"
                                },
                                "shortDescription": {
                                    "type": "string",
                                    "title": "Short Description"
                                },
                                "url": {
                                    "type": "string",
                                    "title": "URL"
                                },
                                "number": {
                                    "type": "number",
                                    "title": "Project Number"
                                },
                                "owner": {
                                    "type": "string",
                                    "title": "Owner"
                                },
                                "public": {
                                    "type": "boolean",
                                    "title": "Public"
                                },
                                "createdAt": {
                                    "type": "string",
                                    "title": "Created At"
                                },
                                "updatedAt": {
                                    "type": "string",
                                    "title": "Updated At"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Total Count",
                    "value": "totalCount",
                    "schema": {
                        "type": "number",
                        "title": "Total Count"
                    }
                }
            ]
        }
    ],
    "quota": {
        "manager": "appmixer:github",
        "resources": ["requests"],
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "data:image/svg+xml;base64,"
}