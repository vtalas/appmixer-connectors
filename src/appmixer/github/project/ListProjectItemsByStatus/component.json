{
    "name": "appmixer.github.project.ListProjectItemsByStatus",
    "label": "List Project Items by Status",
    "description": "List all items in a GitHub project filtered by their status field value (e.g., 'Todo', 'In Progress', 'Done')",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "read:project"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": {
                        "type": "string",
                        "title": "Project ID",
                        "description": "The node ID of the GitHub project"
                    },
                    "statusValue": {
                        "type": "string",
                        "title": "Status Value",
                        "description": "The status value to filter by (e.g., 'Todo', 'In Progress', 'Done')"
                    },
                    "statusFieldName": {
                        "type": "string",
                        "title": "Status Field Name",
                        "description": "The name of the status field (defaults to 'Status')",
                        "default": "Status"
                    },
                    "limit": {
                        "type": "number",
                        "title": "Limit",
                        "description": "Maximum number of items to return (default: 50, max: 100)",
                        "default": 50,
                        "minimum": 1,
                        "maximum": 100
                    }
                },
                "required": ["projectId", "statusValue"]
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "text",
                        "index": 1,
                        "tooltip": "Get the project ID from the GitHub project URL or use the ListProjects component"
                    },
                    "statusValue": {
                        "type": "text",
                        "index": 2,
                        "tooltip": "Enter the exact status value to filter by (case-sensitive)"
                    },
                    "statusFieldName": {
                        "type": "text",
                        "index": 3,
                        "tooltip": "The name of the status field in your project (usually 'Status')"
                    },
                    "limit": {
                        "type": "number",
                        "index": 4,
                        "tooltip": "Number of items to return (1-100)"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Items",
                    "value": "items",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "Item ID"
                                },
                                "title": {
                                    "type": "string",
                                    "title": "Title"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Item Type"
                                },
                                "status": {
                                    "type": "string",
                                    "title": "Status"
                                },
                                "assignees": {
                                    "type": "array",
                                    "title": "Assignees",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "url": {
                                    "type": "string",
                                    "title": "URL"
                                },
                                "repository": {
                                    "type": "string",
                                    "title": "Repository"
                                },
                                "labels": {
                                    "type": "array",
                                    "title": "Labels",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "fieldValues": {
                                    "type": "object",
                                    "title": "Field Values"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Total Count",
                    "value": "totalCount"
                },
                {
                    "label": "Filtered Count",
                    "value": "filteredCount"
                }
            ]
        }
    ],
    "quota": {
        "manager": "appmixer:github",
        "resources": ["github.api"],
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png"
}