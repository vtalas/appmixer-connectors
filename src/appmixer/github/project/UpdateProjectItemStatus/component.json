{
    "name": "appmixer.github.project.UpdateProjectItemStatus",
    "label": "Update Project Item Status",
    "description": "Update the status field of a project item",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "project"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": {
                        "type": "string",
                        "title": "Project ID",
                        "description": "The node ID of the GitHub project"
                    },
                    "itemId": {
                        "type": "string",
                        "title": "Item ID",
                        "description": "The node ID of the project item to update"
                    },
                    "statusValue": {
                        "type": "string",
                        "title": "Status Value",
                        "description": "The new status value (e.g., 'Todo', 'In Progress', 'Done')"
                    },
                    "statusFieldName": {
                        "type": "string",
                        "title": "Status Field Name",
                        "description": "The name of the status field (defaults to 'Status')",
                        "default": "Status"
                    }
                },
                "required": ["projectId", "itemId", "statusValue"]
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "text",
                        "index": 1,
                        "tooltip": "The project ID from the GitHub project URL or ListProjects component"
                    },
                    "itemId": {
                        "type": "text",
                        "index": 2,
                        "tooltip": "The item ID from project items list or AddProjectItem component"
                    },
                    "statusValue": {
                        "type": "text",
                        "index": 3,
                        "tooltip": "The new status value (must match available options)"
                    },
                    "statusFieldName": {
                        "type": "text",
                        "index": 4,
                        "tooltip": "The name of the status field in your project (usually 'Status')"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Item ID",
                    "value": "itemId"
                },
                {
                    "label": "Success",
                    "value": "success"
                },
                {
                    "label": "Status",
                    "value": "status"
                }
            ]
        }
    ],
    "quota": {
        "manager": "appmixer:github",
        "resources": ["github.api"],
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "icon": "https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png"
}