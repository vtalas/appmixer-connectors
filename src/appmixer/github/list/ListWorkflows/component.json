{
    "name": "appmixer.github.list.ListWorkflows",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "List GitHub Actions workflows in a repository.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        "in"
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "result": {
                        "type": "array",
                        "title": "Workflows",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "number",
                                    "title": "ID",
                                    "example": 161335
                                },
                                "node_id": {
                                    "type": "string",
                                    "title": "Node ID",
                                    "example": "MDg6V29ya2Zsb3cxNjEzMzU="
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "CI"
                                },
                                "path": {
                                    "type": "string",
                                    "title": "Path",
                                    "example": ".github/workflows/ci.yml"
                                },
                                "state": {
                                    "type": "string",
                                    "title": "State",
                                    "example": "active"
                                },
                                "created_at": {
                                    "type": "string",
                                    "title": "Created At",
                                    "example": "2020-01-08T23:48:37.000-08:00"
                                },
                                "updated_at": {
                                    "type": "string",
                                    "title": "Updated At",
                                    "example": "2020-01-08T23:50:21.000-08:00"
                                },
                                "url": {
                                    "type": "string",
                                    "title": "URL",
                                    "example": "https://api.github.com/repos/octocat/hello-world/actions/workflows/161335"
                                },
                                "html_url": {
                                    "type": "string",
                                    "title": "HTML URL",
                                    "example": "https://github.com/octocat/hello-world/blob/master/.github/workflows/ci.yml"
                                },
                                "badge_url": {
                                    "type": "string",
                                    "title": "Badge URL",
                                    "example": "https://github.com/octocat/hello-world/workflows/CI/badge.svg"
                                }
                            }
                        },
                        "example": [
                            {
                                "id": 161335,
                                "node_id": "MDg6V29ya2Zsb3cxNjEzMzU=",
                                "name": "CI",
                                "path": ".github/workflows/ci.yml",
                                "state": "active",
                                "created_at": "2020-01-08T23:48:37.000-08:00",
                                "updated_at": "2020-01-08T23:50:21.000-08:00",
                                "url": "https://api.github.com/repos/octocat/hello-world/actions/workflows/161335",
                                "html_url": "https://github.com/octocat/hello-world/blob/master/.github/workflows/ci.yml",
                                "badge_url": "https://github.com/octocat/hello-world/workflows/CI/badge.svg"
                            }
                        ]
                    },
                    "count": {
                        "type": "integer",
                        "title": "Count",
                        "example": 3
                    }
                }
            }
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "repositoryId": {
                    "type": "string",
                    "pattern": "[^/]+[/][^/]+"
                }
            },
            "required": [
                "repositoryId"
            ]
        },
        "inspector": {
            "inputs": {
                "repositoryId": {
                    "type": "select",
                    "group": "config",
                    "label": "Repository",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                        "data": {
                            "transform": "./transformers#reposToSelectArray"
                        }
                    },
                    "tooltip": "Select a repository."
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}
