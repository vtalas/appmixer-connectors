{
    "name": "appmixer.github.list.DispatchWorkflow",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Trigger a GitHub Actions workflow run (workflow_dispatch event).",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        "in"
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "title": "Success",
                        "example": true
                    },
                    "repositoryId": {
                        "type": "string",
                        "title": "Repository",
                        "example": "octocat/hello-world"
                    },
                    "workflowId": {
                        "type": "string",
                        "title": "Workflow ID",
                        "example": "ci.yml"
                    },
                    "ref": {
                        "type": "string",
                        "title": "Git Reference",
                        "example": "main"
                    }
                }
            }
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "repositoryId": {
                    "type": "string",
                    "pattern": "[^/]+[/][^/]+"
                },
                "workflowId": {
                    "type": "string"
                },
                "ref": {
                    "type": "string"
                },
                "inputs": {
                    "type": "string"
                }
            },
            "required": [
                "repositoryId",
                "workflowId",
                "ref"
            ]
        },
        "inspector": {
            "inputs": {
                "repositoryId": {
                    "type": "select",
                    "group": "config",
                    "label": "Repository",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                        "data": {
                            "transform": "./transformers#reposToSelectArray"
                        }
                    },
                    "tooltip": "Select a repository."
                },
                "workflowId": {
                    "type": "text",
                    "group": "config",
                    "label": "Workflow ID or File Name",
                    "index": 2,
                    "tooltip": "The numeric workflow ID or the workflow file name (e.g. <code>ci.yml</code>)."
                },
                "ref": {
                    "type": "text",
                    "group": "config",
                    "label": "Git Reference",
                    "index": 3,
                    "tooltip": "The git reference (branch or tag name) from which the workflow run is created (e.g. <code>main</code>)."
                },
                "inputs": {
                    "type": "textarea",
                    "group": "config",
                    "label": "Workflow Inputs",
                    "index": 4,
                    "tooltip": "Optional inputs for the workflow, as a JSON object. Keys must match the workflow's defined inputs."
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}
