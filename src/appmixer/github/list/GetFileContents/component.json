{
    "name": "appmixer.github.list.GetFileContents",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Get the contents of a file from a repository.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        "in"
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "file"
                    },
                    "encoding": {
                        "type": "string",
                        "title": "Encoding",
                        "example": "base64"
                    },
                    "size": {
                        "type": "number",
                        "title": "Size",
                        "example": 5362
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "README.md"
                    },
                    "path": {
                        "type": "string",
                        "title": "Path",
                        "example": "README.md"
                    },
                    "sha": {
                        "type": "string",
                        "title": "SHA",
                        "example": "3d21ec53a331a6f037a91c368710b99387d012c1"
                    },
                    "content": {
                        "type": "string",
                        "title": "Content (base64)",
                        "example": "IyBIZWxsbyBXb3JsZAo="
                    },
                    "decodedContent": {
                        "type": "string",
                        "title": "Decoded Content",
                        "example": "# Hello World\n"
                    },
                    "download_url": {
                        "type": "string",
                        "title": "Download URL",
                        "example": "https://raw.githubusercontent.com/octocat/hello-world/master/README.md"
                    },
                    "html_url": {
                        "type": "string",
                        "title": "HTML URL",
                        "example": "https://github.com/octocat/hello-world/blob/master/README.md"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "schema": {
                "type": "object",
                "properties": {
                    "repositoryId": {
                        "type": "string",
                        "title": "Repository",
                        "example": "octocat/hello-world"
                    },
                    "path": {
                        "type": "string",
                        "title": "Path",
                        "example": "README.md"
                    }
                }
            }
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "repositoryId": {
                    "type": "string",
                    "pattern": "[^/]+[/][^/]+"
                },
                "path": {
                    "type": "string"
                },
                "ref": {
                    "type": "string"
                }
            },
            "required": [
                "repositoryId",
                "path"
            ]
        },
        "inspector": {
            "inputs": {
                "repositoryId": {
                    "type": "select",
                    "group": "config",
                    "label": "Repository",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                        "data": {
                            "transform": "./transformers#reposToSelectArray"
                        }
                    },
                    "tooltip": "Select a repository."
                },
                "path": {
                    "type": "text",
                    "group": "config",
                    "label": "File Path",
                    "index": 2,
                    "tooltip": "Path to the file in the repository (e.g. <code>src/index.js</code>)."
                },
                "ref": {
                    "type": "text",
                    "group": "config",
                    "label": "Git Reference",
                    "index": 3,
                    "tooltip": "Optional branch, tag or commit SHA. Defaults to the repository's default branch."
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}
