{
    "name": "appmixer.github.list.GetWorkflow",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Get a single GitHub Actions workflow by ID or file name.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "user",
            "public_repo",
            "repo",
            "notifications",
            "gist"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        "in"
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "number",
                        "title": "ID",
                        "example": 161335
                    },
                    "node_id": {
                        "type": "string",
                        "title": "Node ID",
                        "example": "MDg6V29ya2Zsb3cxNjEzMzU="
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "CI"
                    },
                    "path": {
                        "type": "string",
                        "title": "Path",
                        "example": ".github/workflows/ci.yml"
                    },
                    "state": {
                        "type": "string",
                        "title": "State",
                        "example": "active"
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2020-01-08T23:48:37.000-08:00"
                    },
                    "updated_at": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2020-01-08T23:50:21.000-08:00"
                    },
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://api.github.com/repos/octocat/hello-world/actions/workflows/161335"
                    },
                    "html_url": {
                        "type": "string",
                        "title": "HTML URL",
                        "example": "https://github.com/octocat/hello-world/blob/master/.github/workflows/ci.yml"
                    },
                    "badge_url": {
                        "type": "string",
                        "title": "Badge URL",
                        "example": "https://github.com/octocat/hello-world/workflows/CI/badge.svg"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "schema": {
                "type": "object",
                "properties": {
                    "repositoryId": {
                        "type": "string",
                        "title": "Repository",
                        "example": "octocat/hello-world"
                    },
                    "workflowId": {
                        "type": "string",
                        "title": "Workflow ID",
                        "example": "ci.yml"
                    }
                }
            }
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "repositoryId": {
                    "type": "string",
                    "pattern": "[^/]+[/][^/]+"
                },
                "workflowId": {
                    "type": "string"
                }
            },
            "required": [
                "repositoryId",
                "workflowId"
            ]
        },
        "inspector": {
            "inputs": {
                "repositoryId": {
                    "type": "select",
                    "group": "config",
                    "label": "Repository",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                        "data": {
                            "transform": "./transformers#reposToSelectArray"
                        }
                    },
                    "tooltip": "Select a repository."
                },
                "workflowId": {
                    "type": "text",
                    "group": "config",
                    "label": "Workflow ID or File Name",
                    "index": 2,
                    "tooltip": "The numeric workflow ID or the workflow file name (e.g. <code>ci.yml</code>)."
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}
