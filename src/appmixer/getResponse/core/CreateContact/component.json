{
    "name": "appmixer.getResponse.core.CreateContact",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/png;base64,",
    "description": "Create a new contact in GetResponse.",
    "private": false,
    "auth": {
        "service": "appmixer:getResponse"
    },
    "quota": {
        "manager": "appmixer:getResponse",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "campaignId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "dayOfCycle": {
                        "type": "number"
                    },
                    "scoring": {
                        "type": "number"
                    },
                    "ipAddress": {
                        "type": "string"
                    },
                    "tags": {
                        "type": "string"
                    }
                },
                "required": [
                    "email",
                    "campaignId"
                ]
            },
            "inspector": {
                "inputs": {
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "tooltip": "The contact's email address.",
                        "index": 1
                    },
                    "campaignId": {
                        "type": "select",
                        "label": "Campaign",
                        "tooltip": "The campaign (list) to add the contact to.",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/getResponse/core/ListCampaigns?outPort=out",
                            "data": {
                                "transform": "./transformers#campaignsToSelectArray"
                            }
                        }
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "tooltip": "The contact's name.",
                        "index": 3
                    },
                    "dayOfCycle": {
                        "type": "number",
                        "label": "Day of Cycle",
                        "tooltip": "The day on which the contact is in the autoresponder cycle. Set to 0 to start from the beginning.",
                        "index": 4
                    },
                    "scoring": {
                        "type": "number",
                        "label": "Scoring",
                        "tooltip": "The contact's scoring value.",
                        "index": 5
                    },
                    "ipAddress": {
                        "type": "text",
                        "label": "IP Address",
                        "tooltip": "The contact's IP address.",
                        "index": 6
                    },
                    "tags": {
                        "type": "text",
                        "label": "Tags",
                        "tooltip": "Comma-separated list of tag IDs to assign to the contact.",
                        "index": 7
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string",
                        "title": "Contact ID"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "campaign": {
                        "type": "object",
                        "title": "Campaign",
                        "properties": {
                            "campaignId": {
                                "type": "string",
                                "title": "Campaign ID"
                            },
                            "name": {
                                "type": "string",
                                "title": "Campaign Name"
                            }
                        }
                    },
                    "createdOn": {
                        "type": "string",
                        "title": "Created On"
                    },
                    "scoring": {
                        "type": "number",
                        "title": "Scoring"
                    }
                }
            }
        }
    ],
    "version": "1.0.0"
}