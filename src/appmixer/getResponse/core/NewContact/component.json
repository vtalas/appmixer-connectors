{
    "name": "appmixer.getResponse.core.NewContact",
    "description": "Triggers when a new contact is added. You can optionally filter by a specific campaign.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:getResponse"
    },
    "quota": {
        "manager": "appmixer:getResponse",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "trigger": true,
    "tick": true,
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "campaignId": {
                    "type": "string",
                    "title": "Campaign"
                }
            }
        },
        "inspector": {
            "inputs": {
                "campaignId": {
                    "type": "select",
                    "label": "Campaign",
                    "tooltip": "Filter contacts by campaign. Leave empty to watch all campaigns.",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/getResponse/core/ListCampaigns?outPort=out",
                        "data": {
                            "transform": "./transformers#campaignsToSelectArray"
                        }
                    }
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "contactId"
                },
                {
                    "label": "Email",
                    "value": "email"
                },
                {
                    "label": "Name",
                    "value": "name"
                },
                {
                    "label": "Campaign ID",
                    "value": "campaign.campaignId"
                },
                {
                    "label": "Campaign Name",
                    "value": "campaign.name"
                },
                {
                    "label": "Created On",
                    "value": "createdOn"
                },
                {
                    "label": "Changed On",
                    "value": "changedOn"
                },
                {
                    "label": "Scoring",
                    "value": "scoring"
                },
                {
                    "label": "Origin",
                    "value": "origin"
                },
                {
                    "label": "IP Address",
                    "value": "ipAddress"
                }
            ]
        }
    ],
    "icon": "data:image/png;base64,"
}