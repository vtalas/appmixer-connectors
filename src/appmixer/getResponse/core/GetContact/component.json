{
    "name": "appmixer.getResponse.core.GetContact",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/png;base64,",
    "description": "Get a contact by ID.",
    "private": false,
    "auth": {
        "service": "appmixer:getResponse"
    },
    "quota": {
        "manager": "appmixer:getResponse",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "contactId": {
                        "type": "string"
                    },
                    "fields": {
                        "type": "string"
                    }
                },
                "required": [
                    "contactId"
                ]
            },
            "inspector": {
                "inputs": {
                    "contactId": {
                        "type": "text",
                        "label": "Contact ID",
                        "tooltip": "The ID of the contact to retrieve.",
                        "index": 1
                    },
                    "fields": {
                        "type": "text",
                        "label": "Fields",
                        "tooltip": "Comma-separated list of fields to return. Leave empty to return all fields.",
                        "index": 2
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "contactId"
                },
                {
                    "label": "Email",
                    "value": "email"
                },
                {
                    "label": "Name",
                    "value": "name"
                },
                {
                    "label": "Campaign ID",
                    "value": "campaign.campaignId"
                },
                {
                    "label": "Campaign Name",
                    "value": "campaign.name"
                },
                {
                    "label": "Created On",
                    "value": "createdOn"
                },
                {
                    "label": "Changed On",
                    "value": "changedOn"
                },
                {
                    "label": "Scoring",
                    "value": "scoring"
                },
                {
                    "label": "Origin",
                    "value": "origin"
                },
                {
                    "label": "Time Zone",
                    "value": "timeZone"
                },
                {
                    "label": "IP Address",
                    "value": "ipAddress"
                },
                {
                    "label": "Activities",
                    "value": "activities"
                },
                {
                    "label": "Tags",
                    "value": "tags"
                },
                {
                    "label": "Custom Fields",
                    "value": "customFieldValues"
                }
            ]
        },
        {
            "name": "notFound",
            "options": [
                {
                    "label": "Contact ID",
                    "value": "contactId"
                }
            ]
        }
    ],
    "version": "1.0.0"
}