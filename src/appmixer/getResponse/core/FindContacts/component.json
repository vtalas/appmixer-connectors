{
    "name": "appmixer.getResponse.core.FindContacts",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/png;base64,",
    "description": "Find contacts in GetResponse with filtering options.",
    "private": false,
    "auth": {
        "service": "appmixer:getResponse"
    },
    "quota": {
        "manager": "appmixer:getResponse",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "properties": {
                "generateOutputPortOptions": {
                    "type": "boolean"
                }
            }
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string"
                    },
                    "campaignId": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "origin": {
                        "type": "string"
                    },
                    "createdOnFrom": {
                        "type": "string"
                    },
                    "createdOnTo": {
                        "type": "string"
                    },
                    "sortBy": {
                        "type": "string"
                    },
                    "sortOrder": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "label": "Search Query",
                        "tooltip": "Full-text search query to filter contacts.",
                        "index": 1
                    },
                    "campaignId": {
                        "type": "select",
                        "label": "Campaign",
                        "tooltip": "Filter contacts by campaign.",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/getResponse/core/ListCampaigns?outPort=out",
                            "data": {
                                "transform": "./transformers#campaignsToSelectArray"
                            }
                        }
                    },
                    "email": {
                        "type": "text",
                        "label": "Email",
                        "tooltip": "Filter contacts by email (exact match).",
                        "index": 3
                    },
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "tooltip": "Filter contacts by name.",
                        "index": 4
                    },
                    "origin": {
                        "type": "select",
                        "label": "Origin",
                        "tooltip": "Filter contacts by origin.",
                        "index": 5,
                        "options": [
                            {
                                "label": "All",
                                "value": ""
                            },
                            {
                                "label": "Import",
                                "value": "import"
                            },
                            {
                                "label": "Email",
                                "value": "email"
                            },
                            {
                                "label": "WWW",
                                "value": "www"
                            },
                            {
                                "label": "Panel",
                                "value": "panel"
                            },
                            {
                                "label": "Leads",
                                "value": "leads"
                            },
                            {
                                "label": "Sale",
                                "value": "sale"
                            },
                            {
                                "label": "API",
                                "value": "api"
                            },
                            {
                                "label": "Forward",
                                "value": "forward"
                            },
                            {
                                "label": "Survey",
                                "value": "survey"
                            },
                            {
                                "label": "iContact",
                                "value": "iContact"
                            },
                            {
                                "label": "Webinar",
                                "value": "webinar"
                            },
                            {
                                "label": "Landing Page",
                                "value": "landing_page"
                            }
                        ]
                    },
                    "createdOnFrom": {
                        "type": "date-time",
                        "label": "Created On From",
                        "tooltip": "Filter contacts created on or after this date.",
                        "index": 6
                    },
                    "createdOnTo": {
                        "type": "date-time",
                        "label": "Created On To",
                        "tooltip": "Filter contacts created on or before this date.",
                        "index": 7
                    },
                    "sortBy": {
                        "type": "select",
                        "label": "Sort By",
                        "tooltip": "Field to sort results by.",
                        "index": 8,
                        "defaultValue": "createdOn",
                        "options": [
                            {
                                "label": "Created On",
                                "value": "createdOn"
                            },
                            {
                                "label": "Email",
                                "value": "email"
                            },
                            {
                                "label": "Campaign ID",
                                "value": "campaignId"
                            },
                            {
                                "label": "Name",
                                "value": "name"
                            }
                        ]
                    },
                    "sortOrder": {
                        "type": "select",
                        "label": "Sort Order",
                        "tooltip": "Sort order.",
                        "index": 9,
                        "defaultValue": "desc",
                        "options": [
                            {
                                "label": "Ascending",
                                "value": "asc"
                            },
                            {
                                "label": "Descending",
                                "value": "desc"
                            }
                        ]
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 10,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First item",
                                "value": "first"
                            },
                            {
                                "label": "All at once",
                                "value": "array"
                            },
                            {
                                "label": "One at a time",
                                "value": "object"
                            },
                            {
                                "label": "File",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/getResponse/core/FindContacts?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "options": [
                {
                    "label": "Query",
                    "value": "query"
                }
            ]
        }
    ],
    "version": "1.0.0"
}