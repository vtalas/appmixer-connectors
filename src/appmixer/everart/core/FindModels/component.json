{
    "name": "appmixer.everart.core.FindModels",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Fetches a paginated list of models.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:everart"
    },
    "quota": {
        "manager": "appmixer:everart",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "search": {
                        "type": "string",
                        "description": "Search for models by name",
                        "example": "My Model v1"
                    },
                    "status": {
                        "type": "string",
                        "description": "Filter models by status",
                        "enum": [
                            "PENDING",
                            "PROCESSING",
                            "TRAINING",
                            "READY",
                            "FAILED",
                            "CANCELED"
                        ]
                    },
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "search": {
                        "type": "text",
                        "tooltip": "Search for models by name",
                        "label": "Search",
                        "index": 0
                    },
                    "status": {
                        "type": "text",
                        "tooltip": "Filter models by status",
                        "label": "Status",
                        "index": 1
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 2,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/everart/core/FindModels?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}