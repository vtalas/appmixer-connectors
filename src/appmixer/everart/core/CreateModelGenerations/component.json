{
    "name": "appmixer.everart.core.CreateModelGenerations",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Allows the creation of up to 10 images at once based on a prompt and model.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:everart"
    },
    "quota": {
        "manager": "appmixer:everart",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "prompt": {
                        "type": "string",
                        "description": "The text prompt for the image.",
                        "example": "A beautiful sunset over the ocean."
                    },
                    "image": {
                        "type": "string",
                        "description": "URL of the image to use for ControlNet. (required for img2img type)",
                        "example": "https://images.com/my-image.jpeg"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "txt2img",
                            "img2img"
                        ],
                        "description": "The type of generation to run."
                    },
                    "image_count": {
                        "type": "integer",
                        "description": "The number of images to generate.",
                        "example": 1
                    },
                    "height": {
                        "type": "integer",
                        "description": "The height of the image in pixels.",
                        "default": 1024,
                        "example": 768
                    },
                    "width": {
                        "type": "integer",
                        "description": "The width of the image in pixels.",
                        "default": 1024,
                        "example": 768
                    },
                    "webhook_url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Optional URL that will receive POST requests with status updates",
                        "example": "https://api.myapp.com/webhooks/everart"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "prompt": {
                        "type": "text",
                        "tooltip": "The text prompt for the image.",
                        "label": "Prompt",
                        "index": 0
                    },
                    "image": {
                        "type": "text",
                        "tooltip": "URL of the image to use for ControlNet. (required for img2img type)",
                        "label": "Image",
                        "index": 1
                    },
                    "type": {
                        "type": "text",
                        "tooltip": "The type of generation to run.",
                        "label": "Type",
                        "index": 2
                    },
                    "image_count": {
                        "type": "number",
                        "tooltip": "The number of images to generate.",
                        "label": "Image Count",
                        "index": 3
                    },
                    "height": {
                        "type": "number",
                        "tooltip": "The height of the image in pixels.",
                        "label": "Height",
                        "index": 4
                    },
                    "width": {
                        "type": "number",
                        "tooltip": "The width of the image in pixels.",
                        "label": "Width",
                        "index": 5
                    },
                    "webhook_url": {
                        "type": "text",
                        "tooltip": "Optional URL that will receive POST requests with status updates",
                        "label": "Webhook Url",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Generations",
                    "value": "generations",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "title": "Generations.Id"
                                },
                                "model_id": {
                                    "type": "string",
                                    "title": "Generations.Model Id"
                                },
                                "status": {
                                    "type": "string",
                                    "title": "Generations.Status"
                                },
                                "image_url": {
                                    "type": "string",
                                    "title": "Generations.Image Url"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Generations.Type"
                                },
                                "created_at": {
                                    "type": "string",
                                    "title": "Generations.Created At"
                                },
                                "updated_at": {
                                    "type": "string",
                                    "title": "Generations.Updated At"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Success",
                    "value": "success",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Request Id",
                    "value": "requestId",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}