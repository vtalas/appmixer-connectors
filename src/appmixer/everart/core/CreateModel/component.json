{
    "name": "appmixer.everart.core.CreateModel",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Creates a new model from an array of image URLs or upload tokens.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:everart"
    },
    "quota": {
        "manager": "appmixer:everart",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "The name of the model you are training.",
                        "example": "My Model"
                    },
                    "subject": {
                        "type": "string",
                        "description": "Subject type of the model.",
                        "enum": [
                            "STYLE",
                            "PERSON",
                            "OBJECT"
                        ]
                    },
                    "image_urls": {
                        "type": "array",
                        "description": "Array of URLs pointing to training images",
                        "items": {
                            "type": "string",
                            "format": "uri"
                        },
                        "minItems": 1,
                        "maxItems": 25
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "tooltip": "The name of the model you are training.",
                        "label": "Name",
                        "index": 0
                    },
                    "subject": {
                        "type": "select",
                        "tooltip": "Subject type of the model.",
                        "label": "Subject",
                        "index": 1,
                        "options": [
                            {
                                "label": "STYLE",
                                "value": "STYLE"
                            },
                            {
                                "label": "PERSON",
                                "value": "PERSON"
                            },
                            {
                                "label": "OBJECT",
                                "value": "OBJECT"
                            }
                        ]
                    },
                    "image_urls": {
                        "type": "expression",
                        "tooltip": "Array of URLs pointing to training images",
                        "label": "Image Urls",
                        "index": 2,
                        "fields": {
                            "image_url": {
                                "type": "text",
                                "label": "Street One"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Model",
                    "value": "model",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Model.Id"
                            },
                            "name": {
                                "type": "string",
                                "title": "Model.Name"
                            },
                            "status": {
                                "type": "string",
                                "title": "Model.Status"
                            },
                            "subject": {
                                "type": "string",
                                "title": "Model.Subject"
                            },
                            "thumbnail_url": {
                                "type": "string",
                                "title": "Model.Thumbnail Url"
                            },
                            "created_at": {
                                "type": "string",
                                "title": "Model.Created At"
                            },
                            "updated_at": {
                                "type": "string",
                                "title": "Model.Updated At"
                            },
                            "estimated_completed_at": {
                                "type": "null",
                                "title": "Model.Estimated Completed At"
                            }
                        }
                    }
                },
                {
                    "label": "Success",
                    "value": "success",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "label": "Request Id",
                    "value": "requestId",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}