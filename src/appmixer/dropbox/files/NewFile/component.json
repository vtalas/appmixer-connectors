{
    "name": "appmixer.dropbox.files.NewFile",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This trigger fires every time a new file is added.",
    "private": false,
    "auth": {
        "service": "appmixer:dropbox"
    },
    "tick": true,
    "properties": {
        "schema": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string"
                },
                "recursive": {
                    "type": "boolean"
                }
            }
        },
        "inspector": {
            "inputs": {
                "path": {
                    "type": "text",
                    "label": "Path",
                    "tooltip": "Enter a specific folder to monitor for new files. Example: <code>/Photos</code>.",
                    "index": 1
                },
                "recursive": {
                    "type": "toggle",
                    "label": "Recursive",
                    "defaultValue": false,
                    "tooltip": "Set to monitor the specified folder and all its subfolders for new files. By default, monitoring is not recursive. Note that the maximum number of files that can be monitored is 2000.",
                    "index": 2
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "newFile",
            "schema": {
                "type": "object",
                "properties": {
                    ".tag": {
                        "type": "string",
                        "title": ".tag",
                        "example": "file"
                    },
                    "client_modified": {
                        "type": "string",
                        "title": "client_modified",
                        "example": "2024-07-15T12:30:00Z"
                    },
                    "content_hash": {
                        "type": "string",
                        "title": "content_hash",
                        "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
                    },
                    "id": {
                        "type": "string",
                        "title": "id",
                        "example": "id:abc123def456"
                    },
                    "name": {
                        "type": "string",
                        "title": "name",
                        "example": "report.pdf"
                    },
                    "path_display": {
                        "type": "string",
                        "title": "path_display",
                        "example": "/Documents/report.pdf"
                    },
                    "path_lower": {
                        "type": "string",
                        "title": "path_lower",
                        "example": "/documents/report.pdf"
                    },
                    "rev": {
                        "type": "string",
                        "title": "rev",
                        "example": "015f2e5d4a1c70000000109d2de60"
                    },
                    "server_modified": {
                        "type": "string",
                        "title": "server_modified",
                        "example": "2024-07-15T12:35:00Z"
                    },
                    "size": {
                        "type": "number",
                        "title": "size",
                        "example": 524288
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
