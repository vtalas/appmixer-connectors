{
    "name": "appmixer.dropbox.files.FindFiles",
    "author": "Pawel Putko <pputko@ntrc.eu>",
    "description": "This action finds file.",
    "private": false,
    "auth": {
        "service": "appmixer:dropbox"
    },
    "inPorts": [
        {
            "name": "query",
            "schema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "maxResults": {
                        "type": "number"
                    },
                    "path": {
                        "type": "string",
                        "pattern": "(/(.|[\\r\\n])*)?|id:.*|(ns:[0-9]+(/.*)?)"
                    },
                    "mode": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "name": {
                        "type": "text",
                        "group": "transformation",
                        "index": 1,
                        "label": "Find by name",
                        "attrs": {
                            "label": {
                                "data-tooltip": "The string to search for. The search string is split on spaces into multiple tokens. For file name searching, the last token is used for prefix matching (i.e. \"bat c\" matches \"bat cave\" but not \"batman car\")."
                            }
                        }
                    },
                    "maxResults": {
                        "type": "number",
                        "group": "transformation",
                        "index": 2,
                        "label": "Max results",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Type how much results do you want in return."
                            }
                        }
                    },
                    "path": {
                        "type": "text",
                        "group": "transformation",
                        "index": 3,
                        "label": "Find in path",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Type path where file should be found."
                            }
                        }
                    },
                    "mode": {
                        "type": "select",
                        "options": [
                            {
                                "value": "filename",
                                "content": "Filename"
                            },
                            {
                                "value": "deleted_filename",
                                "content": "Deleted filename"
                            }
                        ],
                        "group": "transformation",
                        "attrs": {
                            "label": {
                                "data-tooltip": "Search mode."
                            }
                        },
                        "label": "Search mode",
                        "index": 4
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ],
                        "index": 5
                    }
                },
                "groups": {
                    "transformation": {
                        "label": "Transformation",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/dropbox/files/FindFiles?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "query/outputType": "inputs/query/outputType",
                        "query/name": "any"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
