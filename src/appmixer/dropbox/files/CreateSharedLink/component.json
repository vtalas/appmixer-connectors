{
    "name": "appmixer.dropbox.files.CreateSharedLink",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a shared link for a file or folder (returns the existing link if one already exists).",
    "private": false,
    "auth": {
        "service": "appmixer:dropbox"
    },
    "version": "1.0.0",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "pattern": "(/(.|[\\r\\n])*)|(ns:[0-9]+(/.*)?)"
                    }
                },
                "required": [
                    "path"
                ]
            },
            "inspector": {
                "inputs": {
                    "path": {
                        "type": "text",
                        "index": 1,
                        "label": "Path",
                        "tooltip": "The path of the file or folder to share. Must begin with /."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    ".tag": {
                        "type": "string",
                        "title": "Tag",
                        "example": "file"
                    },
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://www.dropbox.com/s/abc123/report.pdf?dl=0"
                    },
                    "id": {
                        "type": "string",
                        "title": "ID",
                        "example": "id:abc123def456"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "report.pdf"
                    },
                    "path_lower": {
                        "type": "string",
                        "title": "Path Lower",
                        "example": "/documents/report.pdf"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
