{
    "name": "appmixer.paypal.core.CaptureOrder",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Capture payment for an approved order created with intent CAPTURE.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:paypal"
    },
    "quota": {
        "manager": "appmixer:paypal",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "order_id": {
                        "type": "string"
                    },
                    "paypal_request_id": {
                        "type": "string"
                    },
                    "note_to_payer": {
                        "type": "string"
                    },
                    "payment_source": {
                        "type": "object"
                    }
                },
                "required": [
                    "order_id"
                ]
            },
            "inspector": {
                "inputs": {
                    "order_id": {
                        "type": "text",
                        "tooltip": "The ID of the order to capture.",
                        "label": "Order ID",
                        "index": 0
                    },
                    "paypal_request_id": {
                        "type": "text",
                        "tooltip": "Idempotency key for the capture request (PayPal-Request-Id header). If not provided, PayPal will generate one.",
                        "label": "PayPal Request ID",
                        "index": 1
                    },
                    "note_to_payer": {
                        "type": "text",
                        "tooltip": "Optional note to the payer.",
                        "label": "Note To Payer",
                        "index": 2
                    },
                    "payment_source": {
                        "type": "text",
                        "tooltip": "Optional payment source details if different from order. Must be valid JSON object.",
                        "label": "Payment Source",
                        "index": 3
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "ID",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Purchase Units",
                    "value": "purchase_units",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "payments": {
                                    "type": "object",
                                    "properties": {
                                        "captures": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string",
                                                        "title": "Capture ID"
                                                    },
                                                    "status": {
                                                        "type": "string",
                                                        "title": "Capture Status"
                                                    },
                                                    "amount": {
                                                        "type": "object",
                                                        "properties": {
                                                            "currency_code": {
                                                                "type": "string",
                                                                "title": "Currency Code"
                                                            },
                                                            "value": {
                                                                "type": "string",
                                                                "title": "Amount Value"
                                                            }
                                                        },
                                                        "title": "Amount"
                                                    },
                                                    "final_capture": {
                                                        "type": "boolean",
                                                        "title": "Final Capture"
                                                    },
                                                    "seller_protection": {
                                                        "type": "object",
                                                        "properties": {
                                                            "status": {
                                                                "type": "string",
                                                                "title": "Protection Status"
                                                            }
                                                        },
                                                        "title": "Seller Protection"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Links",
                    "value": "links",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "href": {
                                    "type": "string",
                                    "title": "Link URL"
                                },
                                "rel": {
                                    "type": "string",
                                    "title": "Relation"
                                },
                                "method": {
                                    "type": "string",
                                    "title": "HTTP Method"
                                }
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}