{
    "name": "appmixer.paypal.core.CreateSubscription(CommerceBilling)",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a new subscription using Commerce Billing. Provide external_customer_id, unique external_id, and plan_code. Optionally include start time, trial, and charge overrides.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:paypal"
    },
    "quota": {
        "manager": "appmixer:paypal",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "external_customer_id": {
                        "type": "string"
                    },
                    "external_id": {
                        "type": "string"
                    },
                    "plan_code": {
                        "type": "string"
                    },
                    "start_time": {
                        "type": "string"
                    },
                    "trial|days": {
                        "type": "integer"
                    },
                    "trial|pricing|amount": {
                        "type": "string"
                    },
                    "trial|pricing|currency_code": {
                        "type": "string"
                    },
                    "charge_overrides|code": {
                        "type": "string"
                    },
                    "charge_overrides|amount": {
                        "type": "string"
                    },
                    "charge_overrides|currency_code": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "external_customer_id": {
                        "type": "text",
                        "tooltip": "Your unique identifier for the customer.",
                        "label": "External Customer Id",
                        "index": 0
                    },
                    "external_id": {
                        "type": "text",
                        "tooltip": "Your unique identifier for this subscription.",
                        "label": "External Id",
                        "index": 1
                    },
                    "plan_code": {
                        "type": "text",
                        "tooltip": "The identifier of the plan to subscribe to.",
                        "label": "Plan Code",
                        "index": 2
                    },
                    "start_time": {
                        "type": "text",
                        "tooltip": "ISO-8601 start time for the subscription.",
                        "label": "Start Time",
                        "index": 3
                    },
                    "trial|days": {
                        "type": "number",
                        "tooltip": "Length of trial in days.",
                        "label": "Trial|days",
                        "index": 4
                    },
                    "trial|pricing|amount": {
                        "type": "text",
                        "tooltip": "",
                        "label": "Trial|pricing|amount",
                        "index": 5
                    },
                    "trial|pricing|currency_code": {
                        "type": "text",
                        "tooltip": "",
                        "label": "Trial|pricing|currency Code",
                        "index": 6
                    },
                    "charge_overrides|code": {
                        "type": "text",
                        "tooltip": "Charge code to override.",
                        "label": "Charge Overrides|code",
                        "index": 7
                    },
                    "charge_overrides|amount": {
                        "type": "text",
                        "tooltip": "Override amount value.",
                        "label": "Charge Overrides|amount",
                        "index": 8
                    },
                    "charge_overrides|currency_code": {
                        "type": "text",
                        "tooltip": "ISO-4217 currency code.",
                        "label": "Charge Overrides|currency Code",
                        "index": 9
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "External Id",
                    "value": "external_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "External Customer Id",
                    "value": "external_customer_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Plan Code",
                    "value": "plan_code",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Create Time",
                    "value": "create_time",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Links",
                    "value": "links",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "href": {
                                    "type": "string",
                                    "title": "Links.Href"
                                },
                                "rel": {
                                    "type": "string",
                                    "title": "Links.Rel"
                                },
                                "method": {
                                    "type": "string",
                                    "title": "Links.Method"
                                }
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}