{
    "name": "appmixer.paypal.core.RefundCapture",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Refund a completed capture, full or partial.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:paypal"
    },
    "quota": {
        "manager": "appmixer:paypal",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "capture_id": {
                        "type": "string"
                    },
                    "amount|currency_code": {
                        "type": "string"
                    },
                    "amount|value": {
                        "type": "string"
                    },
                    "invoice_id": {
                        "type": "string"
                    },
                    "note_to_payer": {
                        "type": "string"
                    },
                    "paypal_request_id": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "capture_id": {
                        "type": "text",
                        "tooltip": "The ID of the capture to refund.",
                        "label": "Capture Id",
                        "index": 0
                    },
                    "amount|currency_code": {
                        "type": "text",
                        "tooltip": "Currency code (e.g., USD).",
                        "label": "Amount|currency Code",
                        "index": 1
                    },
                    "amount|value": {
                        "type": "text",
                        "tooltip": "Amount to refund.",
                        "label": "Amount|value",
                        "index": 2
                    },
                    "invoice_id": {
                        "type": "text",
                        "tooltip": "Your invoice identifier for this refund.",
                        "label": "Invoice Id",
                        "index": 3
                    },
                    "note_to_payer": {
                        "type": "text",
                        "tooltip": "A note that appears to the payer in email and on statements.",
                        "label": "Note To Payer",
                        "index": 4
                    },
                    "paypal_request_id": {
                        "type": "text",
                        "tooltip": "Idempotency key (PayPal-Request-Id header).",
                        "label": "Paypal Request Id",
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Amount",
                    "value": "amount",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "currency_code": {
                                "type": "string",
                                "title": "Amount.Currency Code"
                            },
                            "value": {
                                "type": "string",
                                "title": "Amount.Value"
                            }
                        }
                    }
                },
                {
                    "label": "Links",
                    "value": "links",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "href": {
                                    "type": "string",
                                    "title": "Links.Href"
                                },
                                "rel": {
                                    "type": "string",
                                    "title": "Links.Rel"
                                },
                                "method": {
                                    "type": "string",
                                    "title": "Links.Method"
                                }
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}