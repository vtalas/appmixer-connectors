{
    "name": "appmixer.paypal.core.CreateBatchPayout",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a batch payout with up to 15,000 items. Use sender_batch_id for idempotency and set recipient_type, amount, and receiver per item.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:paypal"
    },
    "quota": {
        "manager": "appmixer:paypal",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "sender_batch_header|sender_batch_id": {
                        "type": "string"
                    },
                    "sender_batch_header|email_subject": {
                        "type": "string"
                    },
                    "sender_batch_header|email_message": {
                        "type": "string"
                    },
                    "items|recipient_type": {
                        "type": "string"
                    },
                    "items|receiver": {
                        "type": "string"
                    },
                    "items|amount|currency": {
                        "type": "string"
                    },
                    "items|amount|value": {
                        "type": "string"
                    },
                    "items|note": {
                        "type": "string"
                    },
                    "items|sender_item_id": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "sender_batch_header|sender_batch_id": {
                        "type": "text",
                        "tooltip": "Unique string to ensure idempotency for the batch.",
                        "label": "Sender Batch Header|sender Batch Id",
                        "index": 0
                    },
                    "sender_batch_header|email_subject": {
                        "type": "text",
                        "tooltip": "Subject line for the receiver notification email.",
                        "label": "Sender Batch Header|email Subject",
                        "index": 1
                    },
                    "sender_batch_header|email_message": {
                        "type": "text",
                        "tooltip": "Custom message for the receiver.",
                        "label": "Sender Batch Header|email Message",
                        "index": 2
                    },
                    "items|recipient_type": {
                        "type": "select",
                        "tooltip": "Type of recipient identifier.",
                        "label": "Items|recipient Type",
                        "options": [
                            {
                                "label": "EMAIL",
                                "value": "EMAIL"
                            },
                            {
                                "label": "PHONE",
                                "value": "PHONE"
                            },
                            {
                                "label": "PAYPAL_ID",
                                "value": "PAYPAL_ID"
                            }
                        ],
                        "index": 3
                    },
                    "items|receiver": {
                        "type": "text",
                        "tooltip": "The receiver identifier (email, phone, or PayPal account ID).",
                        "label": "Items|receiver",
                        "index": 4
                    },
                    "items|amount|currency": {
                        "type": "text",
                        "tooltip": "ISO-4217 currency code (e.g., USD).",
                        "label": "Items|amount|currency",
                        "index": 5
                    },
                    "items|amount|value": {
                        "type": "text",
                        "tooltip": "Amount value.",
                        "label": "Items|amount|value",
                        "index": 6
                    },
                    "items|note": {
                        "type": "text",
                        "tooltip": "Optional note to the receiver.",
                        "label": "Items|note",
                        "index": 7
                    },
                    "items|sender_item_id": {
                        "type": "text",
                        "tooltip": "Developer-defined id for correlating payouts.",
                        "label": "Items|sender Item Id",
                        "index": 8
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Batch Header",
                    "value": "batch_header",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "payout_batch_id": {
                                "type": "string",
                                "title": "Batch Header.Payout Batch Id"
                            },
                            "batch_status": {
                                "type": "string",
                                "title": "Batch Header.Batch Status"
                            },
                            "sender_batch_header": {
                                "type": "object",
                                "properties": {
                                    "sender_batch_id": {
                                        "type": "string",
                                        "title": "Batch Header.Sender Batch Header.Sender Batch Id"
                                    }
                                },
                                "title": "Batch Header.Sender Batch Header"
                            }
                        }
                    }
                },
                {
                    "label": "Links",
                    "value": "links",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "href": {
                                    "type": "string",
                                    "title": "Links.Href"
                                },
                                "rel": {
                                    "type": "string",
                                    "title": "Links.Rel"
                                },
                                "method": {
                                    "type": "string",
                                    "title": "Links.Method"
                                }
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}