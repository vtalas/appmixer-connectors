{
    "name": "appmixer.paypal.core.CreateBatchPayout",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Create a batch payout with up to 15,000 items. Use sender_batch_id for idempotency and set recipient_type, amount, and receiver per item.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:paypal"
    },
    "quota": {
        "manager": "appmixer:paypal",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "senderBatchId": {
                        "type": "string"
                    },
                    "emailSubject": {
                        "type": "string"
                    },
                    "emailMessage": {
                        "type": "string"
                    },
                    "recipientType": {
                        "type": "string"
                    },
                    "receiver": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    },
                    "note": {
                        "type": "string"
                    },
                    "senderItemId": {
                        "type": "string"
                    }
                },
                "required": [
                    "senderBatchId",
                    "recipientType",
                    "receiver",
                    "currency",
                    "value"
                ]
            },
            "inspector": {
                "inputs": {
                    "senderBatchId": {
                        "type": "text",
                        "tooltip": "Unique string to ensure idempotency for the batch. Use this to prevent duplicate batch processing.",
                        "label": "Sender Batch ID",
                        "index": 0
                    },
                    "emailSubject": {
                        "type": "text",
                        "tooltip": "Subject line for the receiver notification email.",
                        "label": "Email Subject",
                        "index": 1
                    },
                    "emailMessage": {
                        "type": "text",
                        "tooltip": "Custom message for the receiver.",
                        "label": "Email Message",
                        "index": 2
                    },
                    "recipientType": {
                        "type": "select",
                        "tooltip": "Type of recipient identifier.",
                        "label": "Recipient Type",
                        "options": [
                            {
                                "label": "EMAIL",
                                "value": "EMAIL"
                            },
                            {
                                "label": "PHONE",
                                "value": "PHONE"
                            },
                            {
                                "label": "PAYPAL_ID",
                                "value": "PAYPAL_ID"
                            }
                        ],
                        "index": 3
                    },
                    "receiver": {
                        "type": "text",
                        "tooltip": "The receiver identifier (email, phone, or PayPal account ID).",
                        "label": "Receiver",
                        "index": 4
                    },
                    "currency": {
                        "type": "text",
                        "tooltip": "ISO-4217 currency code (e.g., USD).",
                        "label": "Currency",
                        "index": 5
                    },
                    "value": {
                        "type": "text",
                        "tooltip": "Amount value. Must be a valid decimal amount.",
                        "label": "Amount",
                        "index": 6
                    },
                    "note": {
                        "type": "text",
                        "tooltip": "Optional note to the receiver.",
                        "label": "Note",
                        "index": 7
                    },
                    "senderItemId": {
                        "type": "text",
                        "tooltip": "Developer-defined ID for correlating payouts.",
                        "label": "Sender Item ID",
                        "index": 8
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Payout Batch ID",
                    "value": "payout_batch_id"
                },
                {
                    "label": "Batch Status",
                    "value": "batch_status"
                },
                {
                    "label": "Sender Batch ID",
                    "value": "sender_batch_id"
                },
                {
                    "label": "Links",
                    "value": "links"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}