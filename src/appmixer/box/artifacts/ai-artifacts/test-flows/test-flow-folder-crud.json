{
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 100,
            "y": 200,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "create-folder": {
            "type": "appmixer.box.core.CreateFolder",
            "x": 304,
            "y": 208,
            "version": "1.0.0",
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "name": {}
                                },
                                "lambda": {
                                    "name": "E2E Test Folder"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-folder-created": {
            "type": "appmixer.utils.test.Assert",
            "x": 700,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-folder": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-folder": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "type-check": {
                                            "variable": "$.create-folder.out.type",
                                            "functions": []
                                        },
                                        "name-check": {
                                            "variable": "$.create-folder.out.name",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "type-check",
                                                "assertion": "equal",
                                                "expected": "folder"
                                            },
                                            {
                                                "field": "name-check",
                                                "assertion": "equal",
                                                "expected": "E2E Test Folder"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1104,
            "y": 192,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-folder-created": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-folder": {
            "type": "appmixer.box.core.DeleteFolder",
            "x": 1312,
            "y": 192,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "folderId": {
                                        "var-1": {
                                            "variable": "$.create-folder.out.id",
                                            "functions": []
                                        }
                                    },
                                    "recursive": {}
                                },
                                "lambda": {
                                    "folderId": "",
                                    "recursive": true
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1520,
            "y": 192,
            "version": "1.0.1",
            "source": {
                "in": {
                    "delete-folder": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "delete-folder": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.ai",
                                    "testCase": "E2E Box - folder-crud",
                                    "result": ""
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "name": "E2E Box - folder-crud",
    "type": "automation"
}
