{
    "name": "appmixer.box.core.UpdateFolderMetadata",
    "description": "Updates fields in a folder metadata instance using JSON Patch operations.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "folderId": {
                        "type": "string"
                    },
                    "scope": {
                        "type": "string"
                    },
                    "templateKey": {
                        "type": "string"
                    },
                    "op": {
                        "type": "string"
                    },
                    "path": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    },
                    "from": {
                        "type": "string"
                    }
                },
                "required": [
                    "folderId",
                    "scope",
                    "templateKey",
                    "op",
                    "path"
                ]
            },
            "inspector": {
                "inputs": {
                    "folderId": {
                        "type": "text",
                        "label": "Folder ID",
                        "tooltip": "The ID of the folder.",
                        "index": 1
                    },
                    "scope": {
                        "type": "text",
                        "label": "Scope",
                        "tooltip": "Metadata scope, e.g., enterprise or global.",
                        "index": 2
                    },
                    "templateKey": {
                        "type": "text",
                        "label": "Template Key",
                        "tooltip": "Metadata template key.",
                        "index": 3
                    },
                    "op": {
                        "type": "select",
                        "label": "Operation",
                        "tooltip": "The JSON Patch operation to perform.",
                        "index": 4,
                        "options": [
                            {
                                "label": "Add",
                                "value": "add"
                            },
                            {
                                "label": "Replace",
                                "value": "replace"
                            },
                            {
                                "label": "Remove",
                                "value": "remove"
                            },
                            {
                                "label": "Test",
                                "value": "test"
                            },
                            {
                                "label": "Move",
                                "value": "move"
                            },
                            {
                                "label": "Copy",
                                "value": "copy"
                            }
                        ]
                    },
                    "path": {
                        "type": "text",
                        "label": "Path",
                        "tooltip": "JSON Pointer path to the field (e.g., /fieldName).",
                        "index": 5
                    },
                    "value": {
                        "type": "text",
                        "label": "Value",
                        "tooltip": "Value for add/replace/test operations.",
                        "index": 6
                    },
                    "from": {
                        "type": "text",
                        "label": "From",
                        "tooltip": "Source path for move/copy operations.",
                        "index": 7
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}