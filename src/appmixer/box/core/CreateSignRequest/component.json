{
    "name": "appmixer.box.core.CreateSignRequest",
    "description": "Creates a new Box Sign request for one or more signers.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "sourceFileId": {
                        "type": "string"
                    },
                    "signerEmail": {
                        "type": "string"
                    },
                    "signerRole": {
                        "type": "string"
                    },
                    "signerOrder": {
                        "type": "integer"
                    },
                    "signerIsInPerson": {
                        "type": "boolean"
                    },
                    "parentFolderId": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "subject": {
                        "type": "string"
                    },
                    "redirectUrl": {
                        "type": "string"
                    },
                    "declinedRedirectUrl": {
                        "type": "string"
                    }
                },
                "required": [
                    "sourceFileId",
                    "signerEmail"
                ]
            },
            "inspector": {
                "inputs": {
                    "sourceFileId": {
                        "type": "text",
                        "label": "Source File ID",
                        "tooltip": "ID of the file to be signed",
                        "index": 1
                    },
                    "signerEmail": {
                        "type": "text",
                        "label": "Signer Email",
                        "tooltip": "Email address of the signer",
                        "index": 2
                    },
                    "signerRole": {
                        "type": "select",
                        "label": "Signer Role",
                        "tooltip": "Role of the signer in the signing process",
                        "index": 3,
                        "defaultValue": "signer",
                        "options": [
                            {
                                "label": "Signer",
                                "value": "signer"
                            },
                            {
                                "label": "Approver",
                                "value": "approver"
                            },
                            {
                                "label": "Final Copy Reader",
                                "value": "final_copy_reader"
                            }
                        ]
                    },
                    "signerOrder": {
                        "type": "number",
                        "label": "Signer Order",
                        "tooltip": "Order in which this signer should sign (1, 2, 3, etc.)",
                        "index": 4
                    },
                    "signerIsInPerson": {
                        "type": "toggle",
                        "label": "Is In-Person Signing",
                        "tooltip": "If true, the signer will sign in person",
                        "index": 5
                    },
                    "parentFolderId": {
                        "type": "text",
                        "label": "Parent Folder ID",
                        "tooltip": "ID of the folder where signed document will be stored",
                        "index": 6
                    },
                    "message": {
                        "type": "textarea",
                        "label": "Message",
                        "tooltip": "Message to include in the email sent to signers",
                        "index": 7
                    },
                    "subject": {
                        "type": "text",
                        "label": "Email Subject",
                        "tooltip": "Subject line for the sign request email",
                        "index": 8
                    },
                    "redirectUrl": {
                        "type": "text",
                        "label": "Redirect URL",
                        "tooltip": "URL to redirect signers to after they complete signing",
                        "index": 9
                    },
                    "declinedRedirectUrl": {
                        "type": "text",
                        "label": "Declined Redirect URL",
                        "tooltip": "URL to redirect signers to if they decline to sign",
                        "index": 10
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Sign Request ID",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Status",
                    "value": "status",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Prepare URL",
                    "value": "prepare_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Source Files",
                    "value": "source_files",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "title": "Source Files.Type"
                                },
                                "id": {
                                    "type": "string",
                                    "title": "Source Files.Id"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Source Files.Name"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Signers",
                    "value": "signers",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "role": {
                                    "type": "string",
                                    "title": "Signers.Role"
                                },
                                "email": {
                                    "type": "string",
                                    "title": "Signers.Email"
                                },
                                "is_in_person": {
                                    "type": "boolean",
                                    "title": "Signers.Is In Person"
                                },
                                "order": {
                                    "type": "number",
                                    "title": "Signers.Order"
                                }
                            }
                        }
                    }
                },
                {
                    "label": "Parent Folder",
                    "value": "parent_folder",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Parent Folder.Type"
                            },
                            "id": {
                                "type": "string",
                                "title": "Parent Folder.Id"
                            }
                        }
                    }
                },
                {
                    "label": "Redirect URL",
                    "value": "redirect_url",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Declined Redirect URL",
                    "value": "declined_redirect_url",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}