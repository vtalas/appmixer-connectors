{
    "name": "appmixer.box.core.FindFilesOrFolders",
    "label": "Find Files or Folders",
    "description": "Find files and folders. With a Query it searches the whole account (or a subtree); with the Query left empty it lists the contents of the selected folder. Search returns a maximum of 200 records and relies on the Box search index, which can take several minutes to pick up newly created or modified files — browsing a folder is immediate.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string"
                    },
                    "folderId": {
                        "type": "string"
                    },
                    "exactMatch": {
                        "type": "boolean"
                    },
                    "type": {
                        "type": "string"
                    },
                    "ancestorFolderIds": {
                        "type": "string"
                    },
                    "contentTypes": {
                        "type": [
                            "array",
                            "string"
                        ]
                    },
                    "fields": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string",
                        "default": "array"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "index": 0,
                        "label": "Query",
                        "tooltip": "The search query string (e.g. a file name fragment). Leave empty to list the contents of the folder selected below instead of searching."
                    },
                    "folderId": {
                        "type": "text",
                        "index": 1,
                        "label": "Folder ID",
                        "tooltip": "The folder to work with. Use 0 for the root folder. When Query is empty this folder is listed; when Query is set it limits the search to this folder and its subfolders."
                    },
                    "exactMatch": {
                        "type": "toggle",
                        "index": 2,
                        "label": "Exact Match",
                        "defaultValue": false,
                        "tooltip": "When enabled, only returns items whose name exactly matches the query. Box search uses fuzzy/tokenized matching by default, so this option filters results client-side to return only exact matches."
                    },
                    "type": {
                        "type": "select",
                        "index": 3,
                        "label": "Type",
                        "tooltip": "Filter by item type: file or folder. Applies to both searching and listing.",
                        "options": [
                            {
                                "label": "File",
                                "value": "file"
                            },
                            {
                                "label": "Folder",
                                "value": "folder"
                            }
                        ]
                    },
                    "ancestorFolderIds": {
                        "type": "text",
                        "index": 4,
                        "label": "Ancestor Folder IDs",
                        "tooltip": "Advanced, search only: comma-separated list of ancestor folder IDs to limit the search scope. Overrides Folder ID."
                    },
                    "contentTypes": {
                        "type": "multiselect",
                        "index": 5,
                        "label": "Content Types",
                        "tooltip": "Select content types to search: name, description, file_content, comments, tags.",
                        "options": [
                            {
                                "label": "Name",
                                "value": "name"
                            },
                            {
                                "label": "Description",
                                "value": "description"
                            },
                            {
                                "label": "File Content",
                                "value": "file_content"
                            },
                            {
                                "label": "Comments",
                                "value": "comments"
                            },
                            {
                                "label": "Tags",
                                "value": "tags"
                            }
                        ]
                    },
                    "fields": {
                        "type": "text",
                        "index": 6,
                        "label": "Fields",
                        "tooltip": "Comma-separated list of fields to include. Leave empty to get Box's standard field set when searching, and the fields declared on the output port when listing a folder."
                    },
                    "outputType": {
                        "type": "select",
                        "index": 7,
                        "label": "Output Type",
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/box/core/FindFilesOrFolders?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/query": "any"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
