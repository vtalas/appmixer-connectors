{
    "name": "appmixer.box.core.CopyFile",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Copy a file to a destination folder.",
    "private": false,
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "version": "1.0.0",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    },
                    "parentId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "fileId",
                    "parentId"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "text",
                        "label": "File ID",
                        "index": 1,
                        "tooltip": "The ID of the file to copy."
                    },
                    "parentId": {
                        "type": "text",
                        "label": "Destination Folder ID",
                        "index": 2,
                        "tooltip": "The ID of the folder to copy the file into. Use 0 for the root folder."
                    },
                    "name": {
                        "type": "text",
                        "label": "New Name",
                        "index": 3,
                        "tooltip": "Optional new name for the copied file."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "file"
                    },
                    "id": {
                        "type": "string",
                        "title": "ID",
                        "example": "123456789"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "report.pdf"
                    },
                    "size": {
                        "type": "number",
                        "title": "Size",
                        "example": 102400
                    },
                    "etag": {
                        "type": "string",
                        "title": "ETag",
                        "example": "1"
                    },
                    "sha1": {
                        "type": "string",
                        "title": "SHA1",
                        "example": "0bbd79a..."
                    },
                    "parent": {
                        "type": "object",
                        "title": "Parent",
                        "properties": {
                            "id": {
                                "type": "string",
                                "title": "Parent.ID",
                                "example": "987654321"
                            },
                            "name": {
                                "type": "string",
                                "title": "Parent.Name",
                                "example": "Documents"
                            }
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-01-15T10:30:00-08:00"
                    },
                    "modified_at": {
                        "type": "string",
                        "title": "Modified At",
                        "example": "2026-01-16T08:00:00-08:00"
                    }
                }
            }
        }
    ]
}
