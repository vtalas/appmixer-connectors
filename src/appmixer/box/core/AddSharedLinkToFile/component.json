                            },
                            "download_url": {
                                "type": "string",
                                "title": "Shared Link.Download Url"
                            },
                            "vanity_url": {
                                "type": "null",
                                "title": "Shared Link.Vanity Url"
                            },
                            "vanity_name": {
                                "type": "null",
                                "title": "Shared Link.Vanity Name"
                            },
                            "effective_access": {
