{
    "name": "appmixer.box.core.AddSharedLinkToFile",
    "description": "Add or update a shared link on a file. Configure access levels, passwords, expiration dates, and download/preview permissions.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    },
                    "access": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    },
                    "unsharedAt": {
                        "type": "string"
                    },
                    "canDownload": {
                        "type": "boolean"
                    },
                    "canPreview": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "fileId"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "text",
                        "label": "File ID",
                        "tooltip": "The ID of the file to set a shared link on.",
                        "index": 1
                    },
                    "access": {
                        "type": "select",
                        "label": "Access Level",
                        "tooltip": "The level of access for the shared link.",
                        "index": 2,
                        "options": [
                            {
                                "label": "Open (Anyone with the link)",
                                "value": "open"
                            },
                            {
                                "label": "Company (Only people in your company)",
                                "value": "company"
                            },
                            {
                                "label": "Collaborators (Only people with access to the folder)",
                                "value": "collaborators"
                            }
                        ]
                    },
                    "password": {
                        "type": "text",
                        "label": "Password",
                        "tooltip": "The password required to access the shared link. Leave empty for no password.",
                        "index": 3
                    },
                    "unsharedAt": {
                        "type": "text",
                        "label": "Unshared At",
                        "tooltip": "The date-time when the shared link will be automatically disabled (ISO 8601 format, e.g., 2024-12-31T23:59:59Z). Leave empty for no expiration.",
                        "index": 4
                    },
                    "canDownload": {
                        "type": "toggle",
                        "label": "Can Download",
                        "tooltip": "If the shared link allows for downloading of files. This can only be set when access is set to open or company.\n\n",
                        "index": 5
                    },
                    "canPreview": {
                        "type": "toggle",
                        "label": "Can Preview",
                        "tooltip": "Allow users to preview the file through the shared link.",
                        "index": 6
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "File Version",
                    "value": "file_version",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "File Version.Type"
                            },
                            "id": {
                                "type": "string",
                                "title": "File Version.Id"
                            },
                            "sha1": {
                                "type": "string",
                                "title": "File Version.Sha1"
                            }
                        }
                    }
                },
                {
                    "label": "Sequence Id",
                    "value": "sequence_id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Etag",
                    "value": "etag",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Sha1",
                    "value": "sha1",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Name",
                    "value": "name",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Description",
                    "value": "description",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Size",
                    "value": "size",
                    "schema": {
                        "type": "number"
                    }
                },
                {
                    "label": "Path Collection",
                    "value": "path_collection",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "total_count": {
                                "type": "number",
                                "title": "Path Collection.Total Count"
                            },
                            "entries": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "title": "Path Collection.Entries.Type"
                                        },
                                        "id": {
                                            "type": "string",
                                            "title": "Path Collection.Entries.Id"
                                        },
                                        "sequence_id": {
                                            "type": "null",
                                            "title": "Path Collection.Entries.Sequence Id"
                                        },
                                        "etag": {
                                            "type": "null",
                                            "title": "Path Collection.Entries.Etag"
                                        },
                                        "name": {
                                            "type": "string",
                                            "title": "Path Collection.Entries.Name"
                                        }
                                    }
                                },
                                "title": "Path Collection.Entries"
                            }
                        }
                    }
                },
                {
                    "label": "Created At",
                    "value": "created_at",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Modified At",
                    "value": "modified_at",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Trashed At",
                    "value": "trashed_at",
                    "schema": {
                        "type": "null"
                    }
                },
                {
                    "label": "Purged At",
                    "value": "purged_at",
