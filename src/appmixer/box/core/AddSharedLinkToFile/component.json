                                "title": "Shared Link.Permissions"
                            }
                        }
                    }
                },
                {
                    "label": "Parent",
                    "value": "parent",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "title": "Parent.Type"
                            },
                            "id": {
                                "type": "string",
