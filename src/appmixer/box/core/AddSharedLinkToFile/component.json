                            },
                            "unshared_at": {
                                "type": "null",
                                "title": "Shared Link.Unshared At"
                            },
                            "download_count": {
                                "type": "number",
                                "title": "Shared Link.Download Count"
                            },
                            "preview_count": {
                                "type": "number",
                                "title": "Shared Link.Preview Count"
                            },
                            "access": {
                                "type": "string",
                                "title": "Shared Link.Access"
                            },
                            "permissions": {
                                "type": "object",
                                "properties": {
                                    "can_preview": {
                                        "type": "boolean",
