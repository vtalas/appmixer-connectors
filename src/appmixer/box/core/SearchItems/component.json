{
    "name": "appmixer.box.core.SearchItems",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Searches for files and folders by name, content, type, owner, etc. Returns a maximum of 200 items per search.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    },
                    "ancestor_folder_ids": {
                        "type": "string"
                    },
                    "content_types": {
                        "type": "string"
                    },
                    "limit": {
                        "type": "integer",
                        "default": 30
                    },
                    "offset": {
                        "type": "integer",
                        "default": 0
                    },
                    "fields": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string"
                    }
                },
                "required": [
                    "query"
                ]
            },
            "inspector": {
                "inputs": {
                    "query": {
                        "type": "text",
                        "tooltip": "The search query string (e.g., file name fragment).",
                        "label": "Query",
                        "index": 1
                    },
                    "type": {
                        "type": "text",
                        "tooltip": "Filter by item type: file or folder.",
                        "label": "Type",
                        "index": 2
                    },
                    "ancestor_folder_ids": {
                        "type": "text",
                        "tooltip": "Comma-separated list of ancestor folder IDs to limit scope.",
                        "label": "Ancestor Folder Ids",
                        "index": 3
                    },
                    "content_types": {
                        "type": "text",
                        "tooltip": "Comma-separated content types: name, description, file_content, comments, tags.",
                        "label": "Content Types",
                        "index": 4
                    },
                    "limit": {
                        "type": "number",
                        "tooltip": "Max results to return (1-200). Defaults to 30.",
                        "label": "Limit",
                        "index": 5
                    },
                    "offset": {
                        "type": "number",
                        "tooltip": "Offset for pagination. Defaults to 0.",
                        "label": "Offset",
                        "index": 6
                    },
                    "fields": {
                        "type": "text",
                        "tooltip": "Comma-separated list of fields to include.",
                        "label": "Fields",
                        "index": 7
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 8,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/box/core/SearchItems?outPort=out",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        },
        {
            "name": "notFound"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}