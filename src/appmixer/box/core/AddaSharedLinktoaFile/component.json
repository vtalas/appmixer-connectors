{
    "name": "appmixer.box.core.AddaSharedLinktoaFile",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Adds or updates a shared link on a file.",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "file_id": {
                        "type": "string"
                    },
                    "shared_link|access": {
                        "type": "string"
                    },
                    "shared_link|password": {
                        "type": "string"
                    },
                    "shared_link|unshared_at": {
                        "type": "string"
                    },
                    "shared_link|permissions|can_download": {
                        "type": "boolean"
                    },
                    "shared_link|permissions|can_preview": {
                        "type": "boolean"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "file_id": {
                        "type": "text",
                        "tooltip": "The ID of the file to set a shared link on.",
                        "label": "File Id",
                        "index": 0
                    },
                    "shared_link|access": {
                        "type": "text",
                        "tooltip": "open, company, or collaborators.",
                        "label": "Shared Link|access",
                        "index": 1
                    },
                    "shared_link|password": {
                        "type": "text",
                        "tooltip": "Password for the link (if enabled).",
                        "label": "Shared Link|password",
                        "index": 2
                    },
                    "shared_link|unshared_at": {
                        "type": "text",
                        "tooltip": "ISO 8601 date-time to disable the link.",
                        "label": "Shared Link|unshared At",
                        "index": 3
                    },
                    "shared_link|permissions|can_download": {
                        "type": "toggle",
                        "tooltip": "Allow downloads.",
                        "label": "Shared Link|permissions|can Download",
                        "index": 4
                    },
                    "shared_link|permissions|can_preview": {
                        "type": "toggle",
                        "tooltip": "Allow previews.",
                        "label": "Shared Link|permissions|can Preview",
                        "index": 5
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Type",
                    "value": "type",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Id",
                    "value": "id",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Shared Link",
                    "value": "shared_link",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "access": {
                                "type": "string",
                                "title": "Shared Link.Access"
                            },
                            "url": {
                                "type": "string",
                                "title": "Shared Link.Url"
                            },
                            "download_url": {
                                "type": "string",
                                "title": "Shared Link.Download Url"
                            },
                            "permissions": {
                                "type": "object",
                                "properties": {
                                    "can_download": {
                                        "type": "boolean",
                                        "title": "Shared Link.Permissions.Can Download"
                                    },
                                    "can_preview": {
                                        "type": "boolean",
                                        "title": "Shared Link.Permissions.Can Preview"
                                    }
                                },
                                "title": "Shared Link.Permissions"
                            }
                        }
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}