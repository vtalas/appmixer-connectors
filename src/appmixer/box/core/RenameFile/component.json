{
    "name": "appmixer.box.core.RenameFile",
    "description": "Rename a file by its ID.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:box"
    },
    "quota": {
        "manager": "appmixer:box",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "fileId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "ifMatch": {
                        "type": "string"
                    }
                },
                "required": [
                    "fileId",
                    "name"
                ]
            },
            "inspector": {
                "inputs": {
                    "fileId": {
                        "type": "text",
                        "index": 1,
                        "label": "File ID",
                        "tooltip": "The ID of the file to rename."
                    },
                    "name": {
                        "type": "text",
                        "index": 2,
                        "label": "Name",
                        "tooltip": "The new file name (must include extension)."
                    },
                    "ifMatch": {
                        "type": "text",
                        "index": 3,
                        "label": "If Match",
                        "tooltip": "Optional ETag to prevent race conditions. Sent as If-Match header."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "File ID",
                    "value": "id"
                },
                {
                    "label": "Name",
                    "value": "name"
                },
                {
                    "label": "Type",
                    "value": "type"
                },
                {
                    "label": "Size",
                    "value": "size"
                },
                {
                    "label": "Created At",
                    "value": "created_at"
                },
                {
                    "label": "Modified At",
                    "value": "modified_at"
                },
                {
                    "label": "Etag",
                    "value": "etag"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}