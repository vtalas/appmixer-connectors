{
  "name": "@yoobic-appmixer/google",
  "version": "1.0.186",
  "license": "UNLICENSED",
  "author": "Avi Haiat <thaiat@yoobic.com>",
  "scripts": {
    "appmixer:pack": "rimraf ./coverage && npx appmixer pack -o ../../dist/${npm_package_name}.zip",
    "appmixer:publish": "npm run appmixer:pack && npx appmixer publish ../../dist/${npm_package_name}.zip",
    "depcheck": "npx depcheck",
    "test": "jest",
    "test:appmixer": "concurrently -p none npm:test:appmixer:*",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "axios": "^0.27.2",
    "bluebird": "^3.7.2",
    "deep-object-diff": "^1.1.7",
    "googleapis": "^12.2.0",
    "lodash": "^4.17.21"
  }
}
