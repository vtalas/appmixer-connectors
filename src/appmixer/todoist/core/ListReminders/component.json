{
    "name": "appmixer.todoist.core.ListReminders",
    "author": "Appmixer <info@appmixer.com>",
    "description": "List all reminders.",
    "auth": {
        "service": "appmixer:todoist"
    },
    "quota": {
        "manager": "appmixer:todoist",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "outputType": { "type": "string" }
                }
            },
            "inspector": {
                "inputs": {
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "tooltip": "Choose how to output the reminders.",
                        "index": 1,
                        "defaultValue": "array",
                        "options": [
                            { "label": "First", "value": "first" },
                            { "label": "Array", "value": "array" },
                            { "label": "Object", "value": "object" },
                            { "label": "File", "value": "file" }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Records", "value": "records" },
                { "label": "ID", "value": "id" },
                { "label": "Task ID", "value": "item_id" },
                { "label": "Type", "value": "type" },
                { "label": "Due String", "value": "due.string" },
                { "label": "Due Date", "value": "due.date" },
                { "label": "Due Datetime", "value": "due.datetime" },
                { "label": "Due Timezone", "value": "due.timezone" },
                { "label": "Minute Offset", "value": "minute_offset" },
                { "label": "File ID", "value": "fileId" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
