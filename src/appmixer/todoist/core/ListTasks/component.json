{
    "name": "appmixer.todoist.core.ListTasks",
    "author": "Appmixer <info@appmixer.com>",
    "description": "List tasks with optional filters.",
    "auth": {
        "service": "appmixer:todoist"
    },
    "quota": {
        "manager": "appmixer:todoist",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": { "type": "string" },
                    "sectionId": { "type": "string" },
                    "labelId": { "type": "string" },
                    "filter": { "type": "string" },
                    "lang": { "type": "string" },
                    "ids": { "type": "string" },
                    "outputType": { "type": "string" }
                }
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "select",
                        "label": "Project",
                        "tooltip": "Filter tasks by project.",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/todoist/core/ListProjectsSelect?outPort=out",
                            "data": {
                                "transform": "./transformers#projectsToSelectArray"
                            }
                        }
                    },
                    "sectionId": {
                        "type": "select",
                        "label": "Section",
                        "tooltip": "Filter tasks by section.",
                        "index": 2,
                        "source": {
                            "url": "/component/appmixer/todoist/core/ListSectionsSelect?outPort=out",
                            "data": {
                                "properties": { "projectId": "properties/projectId" },
                                "transform": "./transformers#sectionsToSelectArray"
                            }
                        }
                    },
                    "labelId": {
                        "type": "text",
                        "label": "Label",
                        "tooltip": "Filter tasks by label name.",
                        "index": 3
                    },
                    "filter": {
                        "type": "text",
                        "label": "Filter",
                        "tooltip": "Filter by any Todoist filter query, e.g., 'today', 'p1', 'overdue'.",
                        "index": 4
                    },
                    "lang": {
                        "type": "select",
                        "label": "Language",
                        "tooltip": "Language for parsing filter.",
                        "index": 5,
                        "options": [
                            { "label": "English", "value": "en" },
                            { "label": "Danish", "value": "da" },
                            { "label": "German", "value": "de" },
                            { "label": "Spanish", "value": "es" },
                            { "label": "French", "value": "fr" },
                            { "label": "Italian", "value": "it" },
                            { "label": "Japanese", "value": "ja" },
                            { "label": "Korean", "value": "ko" },
                            { "label": "Dutch", "value": "nl" },
                            { "label": "Polish", "value": "pl" },
                            { "label": "Portuguese", "value": "pt" },
                            { "label": "Russian", "value": "ru" },
                            { "label": "Swedish", "value": "sv" },
                            { "label": "Turkish", "value": "tr" },
                            { "label": "Chinese", "value": "zh" }
                        ]
                    },
                    "ids": {
                        "type": "text",
                        "label": "Task IDs",
                        "tooltip": "Comma-separated list of task IDs to retrieve.",
                        "index": 6
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "tooltip": "Choose how to output the tasks.",
                        "index": 7,
                        "defaultValue": "array",
                        "options": [
                            { "label": "First", "value": "first" },
                            { "label": "Array", "value": "array" },
                            { "label": "Object", "value": "object" },
                            { "label": "File", "value": "file" }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Records", "value": "records" },
                { "label": "ID", "value": "id" },
                { "label": "Assigner ID", "value": "assigner_id" },
                { "label": "Assignee ID", "value": "assignee_id" },
                { "label": "Project ID", "value": "project_id" },
                { "label": "Section ID", "value": "section_id" },
                { "label": "Parent ID", "value": "parent_id" },
                { "label": "Order", "value": "order" },
                { "label": "Content", "value": "content" },
                { "label": "Description", "value": "description" },
                { "label": "Is Completed", "value": "is_completed" },
                { "label": "Labels", "value": "labels" },
                { "label": "Priority", "value": "priority" },
                { "label": "Comment Count", "value": "comment_count" },
                { "label": "Creator ID", "value": "creator_id" },
                { "label": "Created At", "value": "created_at" },
                { "label": "Due Date", "value": "due.date" },
                { "label": "Due String", "value": "due.string" },
                { "label": "Due Is Recurring", "value": "due.is_recurring" },
                { "label": "Due Datetime", "value": "due.datetime" },
                { "label": "Due Timezone", "value": "due.timezone" },
                { "label": "Duration Amount", "value": "duration.amount" },
                { "label": "Duration Unit", "value": "duration.unit" },
                { "label": "URL", "value": "url" },
                { "label": "File ID", "value": "fileId" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
