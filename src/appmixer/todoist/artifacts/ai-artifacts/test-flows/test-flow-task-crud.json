{
    "flow": {
        "start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 100,
            "y": 320,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 200,
            "y": 320,
            "source": {
                "in": {
                    "start": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "taskContent",
                                                "text": "E2E Test Task - CRUD"
                                            },
                                            {
                                                "type": "text",
                                                "name": "updatedTaskContent",
                                                "text": "E2E Test Task - Updated"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-task": {
            "type": "appmixer.todoist.core.CreateTask",
            "x": 400,
            "y": 320,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "content": {
                                        "var-content": {
                                            "variable": "$.set-variables.out.taskContent",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "content": "{{{var-content}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-task": {
            "type": "appmixer.todoist.core.GetTask",
            "x": 600,
            "y": 320,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-task": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "taskId": {
                                        "var-task-id": {
                                            "variable": "$.create-task.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "taskId": "{{{var-task-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-get-task": {
            "type": "appmixer.utils.test.Assert",
            "x": 800,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-task": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-content": {
                                            "variable": "$.get-task.out.content",
                                            "functions": []
                                        },
                                        "expected-content": {
                                            "variable": "$.set-variables.out.taskContent",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-content}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-content}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "list-tasks": {
            "type": "appmixer.todoist.core.ListTasks",
            "x": 800,
            "y": 320,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-task": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "outputType": {}
                                },
                                "lambda": {
                                    "outputType": "array"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-list-tasks": {
            "type": "appmixer.utils.test.Assert",
            "x": 1000,
            "y": 440,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-tasks": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-tasks": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-result": {
                                            "variable": "$.list-tasks.out.result",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-result}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "update-task": {
            "type": "appmixer.todoist.core.UpdateTask",
            "x": 1200,
            "y": 320,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-list-tasks": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "assert-list-tasks": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "taskId": {
                                        "var-task-id": {
                                            "variable": "$.create-task.out.id",
                                            "functions": []
                                        }
                                    },
                                    "content": {
                                        "var-updated-content": {
                                            "variable": "$.set-variables.out.updatedTaskContent",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "taskId": "{{{var-task-id}}}",
                                    "content": "{{{var-updated-content}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-update-task": {
            "type": "appmixer.utils.test.Assert",
            "x": 1400,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "update-task": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "update-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-updated-content": {
                                            "variable": "$.update-task.out.content",
                                            "functions": []
                                        },
                                        "expected-updated-content": {
                                            "variable": "$.set-variables.out.updatedTaskContent",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-updated-content}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-updated-content}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "close-task": {
            "type": "appmixer.todoist.core.CloseTask",
            "x": 1400,
            "y": 320,
            "version": "1.0.0",
            "source": {
                "in": {
                    "update-task": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "update-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "taskId": {
                                        "var-task-id": {
                                            "variable": "$.create-task.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "taskId": "{{{var-task-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "reopen-task": {
            "type": "appmixer.todoist.core.ReopenTask",
            "x": 1600,
            "y": 320,
            "version": "1.0.0",
            "source": {
                "in": {
                    "close-task": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "close-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "taskId": {
                                        "var-task-id": {
                                            "variable": "$.create-task.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "taskId": "{{{var-task-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1800,
            "y": 320,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-get-task": [
                        "out"
                    ],
                    "assert-list-tasks": [
                        "out"
                    ],
                    "assert-update-task": [
                        "out"
                    ],
                    "reopen-task": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-task": {
            "type": "appmixer.todoist.core.DeleteTask",
            "x": 2000,
            "y": 320,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "taskId": {
                                        "var-task-id": {
                                            "variable": "$.create-task.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "taskId": "{{{var-task-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 2200,
            "y": 320,
            "version": "1.0.1",
            "source": {
                "in": {
                    "delete-task": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "delete-task": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.ai",
                                    "testCase": "E2E Todoist - task-crud",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "name": "E2E Todoist - task-crud",
    "type": "automation"
}
