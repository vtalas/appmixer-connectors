{
    "flow": {
        "on-start": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 100,
            "y": 200,
            "source": {},
            "version": "1.0.0",
            "config": {}
        },
        "set-variables": {
            "type": "appmixer.utils.controls.SetVariable",
            "x": 200,
            "y": 200,
            "source": {
                "in": {
                    "on-start": [
                        "out"
                    ]
                }
            },
            "version": "1.0.0",
            "config": {
                "transform": {
                    "in": {
                        "on-start": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "variables": {}
                                },
                                "lambda": {
                                    "variables": {
                                        "ADD": [
                                            {
                                                "type": "text",
                                                "name": "projectName",
                                                "text": "E2E Test Project"
                                            },
                                            {
                                                "type": "text",
                                                "name": "updatedProjectName",
                                                "text": "E2E Test Project Updated"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "create-project": {
            "type": "appmixer.todoist.core.CreateProject",
            "x": 400,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "set-variables": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "set-variables": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "name": {
                                        "var-name": {
                                            "variable": "$.set-variables.out.projectName",
                                            "functions": []
                                        }
                                    },
                                    "color": {},
                                    "isFavorite": {},
                                    "viewStyle": {}
                                },
                                "lambda": {
                                    "name": "{{{var-name}}}",
                                    "color": "blue",
                                    "isFavorite": false,
                                    "viewStyle": "list"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-create": {
            "type": "appmixer.utils.test.Assert",
            "x": 600,
            "y": 100,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-project": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-project": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-name": {
                                            "variable": "$.create-project.out.name",
                                            "functions": []
                                        },
                                        "expected-name": {
                                            "variable": "$.set-variables.out.projectName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-name}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-name}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-project": {
            "type": "appmixer.todoist.core.GetProject",
            "x": 600,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-project": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-project": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "projectId": {
                                        "var-project-id": {
                                            "variable": "$.create-project.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "projectId": "{{{var-project-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-get": {
            "type": "appmixer.utils.test.Assert",
            "x": 800,
            "y": 100,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-project": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-project": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-id": {
                                            "variable": "$.get-project.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-id}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "list-projects": {
            "type": "appmixer.todoist.core.ListProjects",
            "x": 600,
            "y": 300,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-project": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-project": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "outputType": {}
                                },
                                "lambda": {
                                    "outputType": "array"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-list": {
            "type": "appmixer.utils.test.Assert",
            "x": 800,
            "y": 300,
            "version": "1.0.0",
            "source": {
                "in": {
                    "list-projects": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "list-projects": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-result": {
                                            "variable": "$.list-projects.out.result",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-result}}}",
                                                "assertion": "notEmpty"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "update-project": {
            "type": "appmixer.todoist.core.UpdateProject",
            "x": 800,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-project": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-project": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "projectId": {
                                        "var-project-id": {
                                            "variable": "$.create-project.out.id",
                                            "functions": []
                                        }
                                    },
                                    "name": {
                                        "var-updated-name": {
                                            "variable": "$.set-variables.out.updatedProjectName",
                                            "functions": []
                                        }
                                    },
                                    "color": {},
                                    "isFavorite": {}
                                },
                                "lambda": {
                                    "projectId": "{{{var-project-id}}}",
                                    "name": "{{{var-updated-name}}}",
                                    "color": "red",
                                    "isFavorite": true
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-update": {
            "type": "appmixer.utils.test.Assert",
            "x": 1000,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "update-project": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "update-project": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "field-update-name": {
                                            "variable": "$.update-project.out.name",
                                            "functions": []
                                        },
                                        "expected-update-name": {
                                            "variable": "$.set-variables.out.updatedProjectName",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{field-update-name}}}",
                                                "assertion": "equal",
                                                "expected": "{{{expected-update-name}}}"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1200,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-create": [
                        "out"
                    ],
                    "assert-get": [
                        "out"
                    ],
                    "assert-list": [
                        "out"
                    ],
                    "assert-update": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-project": {
            "type": "appmixer.todoist.core.DeleteProject",
            "x": 1400,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": [
                        "out"
                    ]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "projectId": {
                                        "var-project-id": {
                                            "variable": "$.create-project.out.id",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "projectId": "{{{var-project-id}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1600,
            "y": 200,
            "version": "1.0.1",
            "source": {
                "in": {
                    "delete-project": [
                        "out"
                    ]
                }
            },
            "config": {
                "properties": {},
                "transform": {
                    "in": {
                        "delete-project": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "test@appmixer.ai",
                                    "testCase": "E2E Todoist - project-crud",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "name": "E2E Todoist - project-crud",
    "type": "automation"
}
