{
    "name": "appmixer.jira.issues.AddComment",
    "description": "Add a comment to an issue.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:jira",
        "scope": [
            "write:jira-work",
            "read:jira-work"
        ]
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "comment": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "comment"
                ]
            },
            "inspector": {
                "inputs": {
                    "id": {
                        "type": "text",
                        "label": "Issue ID or Key",
                        "index": 1,
                        "tooltip": "Enter the ID or Key of the issue."
                    },
                    "comment": {
                        "type": "textarea",
                        "label": "Comment",
                        "index": 2,
                        "tooltip": "The text of the comment to add."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id",
                        "example": "10001"
                    },
                    "self": {
                        "type": "string",
                        "title": "Self",
                        "example": "https://your-domain.atlassian.net/rest/api/3/issue/10010/comment/10001"
                    },
                    "created": {
                        "type": "string",
                        "title": "Created",
                        "example": "2024-01-15T09:30:00.000+0000"
                    },
                    "updated": {
                        "type": "string",
                        "title": "Updated",
                        "example": "2024-01-15T09:30:00.000+0000"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
