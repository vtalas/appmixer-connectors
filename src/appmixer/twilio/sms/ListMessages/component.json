{
    "name": "appmixer.twilio.sms.ListMessages",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "List SMS/MMS messages, optionally filtered by sender or recipient.",
    "private": false,
    "auth": {
        "service": "appmixer:twilio"
    },
    "version": "1.0.0",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "to": {
                        "type": "string"
                    },
                    "from": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "to": {
                        "type": "text",
                        "label": "To",
                        "index": 1,
                        "tooltip": "Only return messages sent to this phone number (E.164 format)."
                    },
                    "from": {
                        "type": "text",
                        "label": "From",
                        "index": 2,
                        "tooltip": "Only return messages sent from this phone number (E.164 format)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "title": "Messages",
                        "items": {
                            "type": "object",
                            "properties": {
                                "sid": {
                                    "type": "string",
                                    "title": "SID",
                                    "example": "SM1234567890abcdef1234567890abcdef"
                                },
                                "body": {
                                    "type": "string",
                                    "title": "Body",
                                    "example": "Hello from Appmixer!"
                                },
                                "status": {
                                    "type": "string",
                                    "title": "Status",
                                    "example": "delivered"
                                },
                                "to": {
                                    "type": "string",
                                    "title": "To",
                                    "example": "+15558675309"
                                },
                                "from": {
                                    "type": "string",
                                    "title": "From",
                                    "example": "+15017122661"
                                },
                                "direction": {
                                    "type": "string",
                                    "title": "Direction",
                                    "example": "outbound-api"
                                },
                                "numSegments": {
                                    "type": "string",
                                    "title": "Num Segments",
                                    "example": "1"
                                },
                                "price": {
                                    "type": "string",
                                    "title": "Price",
                                    "example": "-0.00750"
                                },
                                "priceUnit": {
                                    "type": "string",
                                    "title": "Price Unit",
                                    "example": "USD"
                                },
                                "dateSent": {
                                    "type": "string",
                                    "title": "Date Sent",
                                    "example": "2026-01-15T10:30:00.000Z"
                                },
                                "errorCode": {
                                    "type": "string",
                                    "title": "Error Code",
                                    "example": "30007"
                                },
                                "errorMessage": {
                                    "type": "string",
                                    "title": "Error Message",
                                    "example": "Carrier violation"
                                }
                            }
                        },
                        "example": [
                            {
                                "sid": "SM1234567890abcdef1234567890abcdef",
                                "body": "Hello from Appmixer!",
                                "status": "delivered",
                                "to": "+15558675309",
                                "from": "+15017122661",
                                "direction": "outbound-api",
                                "numSegments": "1",
                                "price": "-0.00750",
                                "priceUnit": "USD",
                                "dateSent": "2026-01-15T10:30:00.000Z",
                                "errorCode": "30007",
                                "errorMessage": "Carrier violation"
                            }
                        ]
                    },
                    "count": {
                        "type": "integer",
                        "title": "Count",
                        "example": 2
                    }
                }
            }
        }
    ]
}
