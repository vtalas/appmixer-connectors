{
    "name": "appmixer.calendly.actions.ListScheduledEvents",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "List the scheduled events of the authenticated user.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:calendly"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "minStartTime": {
                        "type": "string"
                    },
                    "maxStartTime": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "status": {
                        "type": "select",
                        "label": "Status",
                        "index": 1,
                        "tooltip": "Filter by event status.",
                        "options": [
                            {
                                "label": "Active",
                                "value": "active"
                            },
                            {
                                "label": "Canceled",
                                "value": "canceled"
                            }
                        ]
                    },
                    "minStartTime": {
                        "type": "date-time",
                        "label": "Min Start Time",
                        "index": 2,
                        "tooltip": "Only return events starting at or after this time."
                    },
                    "maxStartTime": {
                        "type": "date-time",
                        "label": "Max Start Time",
                        "index": 3,
                        "tooltip": "Only return events starting at or before this time."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "title": "Scheduled Events",
                        "items": {
                            "type": "object",
                            "properties": {
                                "uri": {
                                    "type": "string",
                                    "title": "URI",
                                    "example": "https://api.calendly.com/scheduled_events/XYZ789"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "30 Minute Meeting"
                                },
                                "status": {
                                    "type": "string",
                                    "title": "Status",
                                    "example": "active"
                                },
                                "start_time": {
                                    "type": "string",
                                    "title": "Start Time",
                                    "example": "2026-02-01T15:00:00.000000Z"
                                },
                                "end_time": {
                                    "type": "string",
                                    "title": "End Time",
                                    "example": "2026-02-01T15:30:00.000000Z"
                                },
                                "created_at": {
                                    "type": "string",
                                    "title": "Created At",
                                    "example": "2026-01-15T09:30:00.000000Z"
                                }
                            }
                        },
                        "example": [
                            {
                                "uri": "https://api.calendly.com/scheduled_events/XYZ789",
                                "name": "30 Minute Meeting",
                                "status": "active",
                                "start_time": "2026-02-01T15:00:00.000000Z",
                                "end_time": "2026-02-01T15:30:00.000000Z",
                                "created_at": "2026-01-15T09:30:00.000000Z"
                            }
                        ]
                    },
                    "count": {
                        "type": "integer",
                        "title": "Count",
                        "example": 2
                    }
                }
            }
        }
    ]
}
