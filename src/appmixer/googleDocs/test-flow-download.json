{
    "name": "E2E Google Docs - download",
    "description": "End-to-end test for Google Docs download functionality - tests DownloadDocument component",
    "flow": {
        "start-component": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 100,
            "y": 200,
            "source": {},
            "version": "1.0.0",
            "config": {
                "transform": {}
            }
        },
        "create-document": {
            "type": "appmixer.googleDocs.core.CreateDocument",
            "x": 300,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "start-component": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "start-component": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "title": {}
                                },
                                "lambda": {
                                    "title": "E2E Test Download Document"
                                }
                            }
                        }
                    }
                }
            }
        },
        "insert-paragraph": {
            "type": "appmixer.googleDocs.core.InsertParagraph",
            "x": 500,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-document": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-document": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "documentId": {
                                        "variable-1": {
                                            "variable": "$.create-document.out.documentId",
                                            "functions": []
                                        }
                                    },
                                    "paragraphText": {}
                                },
                                "lambda": {
                                    "documentId": "{{{variable-1}}}",
                                    "paragraphText": "Content for download test."
                                }
                            }
                        }
                    }
                }
            }
        },
        "download-document": {
            "type": "appmixer.googleDocs.core.DownloadDocument",
            "x": 700,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "insert-paragraph": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "insert-paragraph": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "documentId": {
                                        "variable-1": {
                                            "variable": "$.create-document.out.documentId",
                                            "functions": []
                                        }
                                    },
                                    "mimeType": {}
                                },
                                "lambda": {
                                    "documentId": "{{{variable-1}}}",
                                    "mimeType": "application/pdf"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-download-successful": {
            "type": "appmixer.utils.test.Assert",
            "x": 900,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "download-document": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "download-document": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "file-data-check": {
                                            "variable": "$.download-document.out.fileData",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{file-data-check}}}",
                                                "assertion": "notEmpty",
                                                "expected": ""
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1100,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-download-successful": ["out"]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-document": {
            "type": "appmixer.googleDocs.core.DeleteDocument",
            "x": 1300,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "documentId": {
                                        "variable-1": {
                                            "variable": "$.create-document.out.documentId",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "documentId": "{{{variable-1}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1500,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "delete-document": ["out"]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "delete-document": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E Google Docs - download",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
