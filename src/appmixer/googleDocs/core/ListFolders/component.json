{
    "name": "appmixer.googleDocs.core.ListFolders",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Lists all folders in Google Drive. Used internally for folder selection.",
    "version": "1.0.0",
    "private": true,
    "auth": {
        "service": "appmixer:googleDocs",
        "scope": [
            "https://www.googleapis.com/auth/drive.readonly"
        ]
    },
    "quota": {
        "manager": "appmixer:googleDocs",
        "resources": "requests"
    },
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Folder ID", "value": "id" },
                { "label": "Name", "value": "name" }
            ]
        }
    ]
}
