{
    "name": "appmixer.googleDocs.core.CreateDocument",
    "description": "Creates a new Google document with the provided title and optional initial content in HTML format.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:googleDocs",
        "scope": ["https://www.googleapis.com/auth/documents"]
    },
    "quota": {
        "manager": "appmixer:googleDocs",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    }
                },
                "required": ["title"]
            },
            "inspector": {
                "inputs": {
                    "title": {
                        "type": "text",
                        "index": 1,
                        "label": "Title",
                        "tooltip": "The title of the new document."
                    },
                    "content": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Content",
                        "tooltip": "Optional initial content in HTML format to populate the document."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Document ID",
                    "value": "documentId",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Title",
                    "value": "title",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Revision ID",
                    "value": "revisionId",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "label": "Document URL",
                    "value": "documentUrl",
                    "schema": {
                        "type": "string"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,PD94b"
}