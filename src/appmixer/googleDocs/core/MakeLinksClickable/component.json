{
    "name": "appmixer.googleDocs.core.MakeLinksClickable",
    "description": "Makes all text links in a document clickable by converting plain text URLs to hyperlinks. This component scans the document for URLs in plain text format (starting with http:// or https://) and converts them into clickable hyperlinks. If no URLs are found, the component completes successfully with a count of 0.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:googleDocs",
        "scope": [
            "https://www.googleapis.com/auth/documents"
        ]
    },
    "quota": {
        "manager": "appmixer:googleDocs",
        "resources": "requests"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "documentId": {
                        "type": "string"
                    }
                },
                "required": [
                    "documentId"
                ]
            },
            "inspector": {
                "inputs": {
                    "documentId": {
                        "type": "text",
                        "label": "Document ID",
                        "tooltip": "The ID of the document to make links clickable in.",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Links Made Clickable",
                    "value": "links",
                    "schema": {
                        "type": "number"
                    }
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}