{
    "name": "E2E Google Docs - basic operations",
    "description": "End-to-end test for Google Docs connector - creates, modifies, finds, and deletes documents",
    "flow": {
        "start-component": {
            "type": "appmixer.utils.controls.OnStart",
            "x": 100,
            "y": 200,
            "source": {},
            "version": "1.0.0",
            "config": {
                "transform": {}
            }
        },
        "create-document": {
            "type": "appmixer.googleDocs.core.CreateDocument",
            "x": 300,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "start-component": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "start-component": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "title": {}
                                },
                                "lambda": {
                                    "title": "E2E Test Document"
                                }
                            }
                        }
                    }
                }
            }
        },
        "insert-paragraph": {
            "type": "appmixer.googleDocs.core.InsertParagraph",
            "x": 500,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "create-document": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "create-document": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "documentId": {
                                        "variable-1": {
                                            "variable": "$.create-document.out.documentId",
                                            "functions": []
                                        }
                                    },
                                    "paragraphText": {}
                                },
                                "lambda": {
                                    "documentId": "{{{variable-1}}}",
                                    "paragraphText": "This is a test paragraph for E2E testing."
                                }
                            }
                        }
                    }
                }
            }
        },
        "replace-text": {
            "type": "appmixer.googleDocs.core.ReplaceText",
            "x": 700,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "insert-paragraph": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "insert-paragraph": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "documentId": {
                                        "variable-1": {
                                            "variable": "$.create-document.out.documentId",
                                            "functions": []
                                        }
                                    },
                                    "oldText": {},
                                    "newText": {}
                                },
                                "lambda": {
                                    "documentId": "{{{variable-1}}}",
                                    "oldText": "test",
                                    "newText": "automated"
                                }
                            }
                        }
                    }
                }
            }
        },
        "find-documents": {
            "type": "appmixer.googleDocs.core.FindDocuments",
            "x": 900,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "replace-text": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "replace-text": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "query": {},
                                    "outputType": {}
                                },
                                "lambda": {
                                    "query": "name contains 'E2E Test'",
                                    "outputType": "array"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-documents-found": {
            "type": "appmixer.utils.test.Assert",
            "x": 1100,
            "y": 200,
            "version": "1.0.0",
            "source": {
                "in": {
                    "find-documents": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "find-documents": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "count-check": {
                                            "variable": "$.find-documents.out.count",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{count-check}}}",
                                                "assertion": "regex",
                                                "expected": "^[1-9][0-9]*$"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "get-document-content": {
            "type": "appmixer.googleDocs.core.GetDocumentContent",
            "x": 900,
            "y": 350,
            "version": "1.0.0",
            "source": {
                "in": {
                    "replace-text": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "replace-text": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "documentId": {
                                        "variable-1": {
                                            "variable": "$.create-document.out.documentId",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "documentId": "{{{variable-1}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "assert-content-exists": {
            "type": "appmixer.utils.test.Assert",
            "x": 1100,
            "y": 350,
            "version": "1.0.0",
            "source": {
                "in": {
                    "get-document-content": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "get-document-content": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "expression": {
                                        "title-check": {
                                            "variable": "$.get-document-content.out.title",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "expression": {
                                        "AND": [
                                            {
                                                "field": "{{{title-check}}}",
                                                "assertion": "equal",
                                                "expected": "E2E Test Document"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "after-all": {
            "type": "appmixer.utils.test.AfterAll",
            "x": 1300,
            "y": 275,
            "version": "1.0.0",
            "source": {
                "in": {
                    "assert-documents-found": ["out"],
                    "assert-content-exists": ["out"]
                }
            },
            "config": {
                "properties": {
                    "timeout": 30
                }
            }
        },
        "delete-document": {
            "type": "appmixer.googleDocs.core.DeleteDocument",
            "x": 1500,
            "y": 275,
            "version": "1.0.0",
            "source": {
                "in": {
                    "after-all": ["out"]
                }
            },
            "config": {
                "transform": {
                    "in": {
                        "after-all": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "documentId": {
                                        "variable-1": {
                                            "variable": "$.create-document.out.documentId",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "documentId": "{{{variable-1}}}"
                                }
                            }
                        }
                    }
                }
            }
        },
        "process-results": {
            "type": "appmixer.utils.test.ProcessE2EResults",
            "x": 1700,
            "y": 275,
            "version": "1.0.0",
            "source": {
                "in": {
                    "delete-document": ["out"]
                }
            },
            "config": {
                "properties": {
                    "successStoreId": "64f6f1f9193228000754082f",
                    "failedStoreId": "64f6f1f0193228000754082e"
                },
                "transform": {
                    "in": {
                        "delete-document": {
                            "out": {
                                "type": "json2new",
                                "modifiers": {
                                    "recipients": {},
                                    "testCase": {},
                                    "result": {
                                        "result-var": {
                                            "variable": "$.after-all.out",
                                            "functions": []
                                        }
                                    }
                                },
                                "lambda": {
                                    "recipients": "jirka@client.io",
                                    "testCase": "E2E Google Docs - basic operations",
                                    "result": "{{{result-var}}}"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
