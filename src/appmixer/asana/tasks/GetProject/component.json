{
    "name": "appmixer.asana.tasks.GetProject",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Get a single project by its ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:asana"
    },
    "quota": {
        "manager": "appmixer:asana",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "projectId": {
                        "type": "string"
                    }
                },
                "required": [
                    "projectId"
                ]
            },
            "inspector": {
                "inputs": {
                    "projectId": {
                        "type": "text",
                        "label": "Project ID",
                        "index": 1,
                        "tooltip": "Enter the ID (gid) of the project to get."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "gid": {
                        "type": "string",
                        "title": "gid",
                        "example": "1201111111111111"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Product Launch"
                    },
                    "resource_type": {
                        "type": "string",
                        "title": "Resource Type",
                        "example": "project"
                    },
                    "notes": {
                        "type": "string",
                        "title": "Notes",
                        "example": "Everything related to the launch."
                    },
                    "archived": {
                        "type": "boolean",
                        "title": "Archived",
                        "example": false
                    },
                    "color": {
                        "type": "string",
                        "title": "Color",
                        "example": "light-green"
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-01-10T09:00:00.000Z"
                    },
                    "modified_at": {
                        "type": "string",
                        "title": "Modified At",
                        "example": "2026-01-16T08:00:00.000Z"
                    },
                    "permalink_url": {
                        "type": "string",
                        "title": "Permalink URL",
                        "example": "https://app.asana.com/0/1201111111111111/list"
                    }
                }
            }
        }
    ]
}
