{
    "name": "appmixer.asana.tasks.GetTask",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Get a single task by its ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:asana"
    },
    "quota": {
        "manager": "appmixer:asana",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "taskId": {
                        "type": "string"
                    }
                },
                "required": [
                    "taskId"
                ]
            },
            "inspector": {
                "inputs": {
                    "taskId": {
                        "type": "text",
                        "label": "Task ID",
                        "index": 1,
                        "tooltip": "Enter the ID (gid) of the task to get."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "gid": {
                        "type": "string",
                        "title": "gid",
                        "example": "1201234567890123"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "example": "Write the spec"
                    },
                    "resource_type": {
                        "type": "string",
                        "title": "Resource Type",
                        "example": "task"
                    },
                    "completed": {
                        "type": "boolean",
                        "title": "Completed",
                        "example": false
                    },
                    "notes": {
                        "type": "string",
                        "title": "Notes",
                        "example": "Cover all the edge cases."
                    },
                    "due_on": {
                        "type": "string",
                        "title": "Due On",
                        "example": "2026-02-01"
                    },
                    "assignee": {
                        "type": "object",
                        "title": "Assignee",
                        "properties": {
                            "gid": {
                                "type": "string",
                                "title": "Assignee.gid",
                                "example": "1209876543210987"
                            },
                            "name": {
                                "type": "string",
                                "title": "Assignee.Name",
                                "example": "Jane Developer"
                            }
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-01-15T10:30:00.000Z"
                    },
                    "modified_at": {
                        "type": "string",
                        "title": "Modified At",
                        "example": "2026-01-16T08:00:00.000Z"
                    },
                    "permalink_url": {
                        "type": "string",
                        "title": "Permalink URL",
                        "example": "https://app.asana.com/0/1201234567890123/1201234567890123"
                    }
                }
            }
        }
    ]
}
