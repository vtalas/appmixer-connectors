{
    "name": "appmixer.notion.core.AppendBlockChildren",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Append content blocks to a page or block.",
    "auth": {
        "service": "appmixer:notion"
    },
    "quota": {
        "manager": "appmixer:notion",
        "resources": "general",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "private": false,
    "version": "1.0.0",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "blockId": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "children": {
                        "type": "string"
                    }
                },
                "required": [
                    "blockId"
                ]
            },
            "inspector": {
                "inputs": {
                    "blockId": {
                        "type": "text",
                        "index": 1,
                        "label": "Block or Page ID",
                        "tooltip": "Enter the ID of the page or block to append content to."
                    },
                    "content": {
                        "type": "textarea",
                        "index": 2,
                        "label": "Content",
                        "tooltip": "Plain text content. Each line becomes a paragraph block. Ignored if Children (JSON) is provided."
                    },
                    "children": {
                        "type": "textarea",
                        "index": 3,
                        "label": "Children (JSON)",
                        "tooltip": "Optional. A JSON array of Notion block objects for full control over the appended content."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "object": {
                        "type": "string",
                        "title": "Object",
                        "example": "list"
                    },
                    "results": {
                        "type": "array",
                        "title": "Appended Blocks",
                        "items": {
                            "type": "object",
                            "properties": {
                                "object": {
                                    "type": "string",
                                    "title": "Object",
                                    "example": "block"
                                },
                                "id": {
                                    "type": "string",
                                    "title": "Block ID",
                                    "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                                },
                                "type": {
                                    "type": "string",
                                    "title": "Type",
                                    "example": "paragraph"
                                },
                                "has_children": {
                                    "type": "boolean",
                                    "title": "Has Children",
                                    "example": false
                                },
                                "archived": {
                                    "type": "boolean",
                                    "title": "Archived",
                                    "example": false
                                },
                                "created_time": {
                                    "type": "string",
                                    "title": "Created Time",
                                    "example": "2026-01-15T10:30:00.000Z"
                                },
                                "last_edited_time": {
                                    "type": "string",
                                    "title": "Last Edited Time",
                                    "example": "2026-01-15T10:30:00.000Z"
                                }
                            }
                        },
                        "example": [
                            {
                                "object": "block",
                                "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                                "type": "paragraph",
                                "has_children": false,
                                "archived": false,
                                "created_time": "2026-01-15T10:30:00.000Z",
                                "last_edited_time": "2026-01-15T10:30:00.000Z"
                            }
                        ]
                    }
                }
            }
        }
    ]
}
