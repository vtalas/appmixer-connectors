{
    "name": "appmixer.zendesk.tickets.ListTicketFields",
    "author": "Appmixer <info@appmixer.com>",
    "description": "List all ticket fields.",
    "private": false,
    "quota": {
        "manager": "appmixer:zendesk:tickets",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "auth": {
        "service": "appmixer:zendesk:tickets",
        "scope": [
            "read"
        ]
    },
    "icon": "data:image/svg+xml;base64,",
    "version": "1.0.0",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "outputType": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 1,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the fields as one complete list, or one field at a time or a CSV file with all fields.",
                        "options": [
                            {
                                "label": "First Field",
                                "value": "first"
                            },
                            {
                                "label": "All fields at once",
                                "value": "array"
                            },
                            {
                                "label": "One field at a time",
                                "value": "object"
                            },
                            {
                                "label": "CSV file with all fields",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/zendesk/tickets/ListTicketFields?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType"
                    }
                }
            }
        }
    ]
}
