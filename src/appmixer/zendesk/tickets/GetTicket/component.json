{
    "name": "appmixer.zendesk.tickets.GetTicket",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get a single ticket by its ID.",
    "private": false,
    "quota": {
        "manager": "appmixer:zendesk:tickets",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "auth": {
        "service": "appmixer:zendesk:tickets",
        "scope": [
            "read"
        ]
    },
    "icon": "data:image/svg+xml;base64,",
    "version": "1.0.0",
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string"
                    }
                },
                "required": [
                    "ticketId"
                ]
            },
            "inspector": {
                "inputs": {
                    "ticketId": {
                        "type": "text",
                        "label": "Ticket ID",
                        "index": 1,
                        "tooltip": "Enter the ID of the ticket to get."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "ID",
                        "example": 35436
                    },
                    "subject": {
                        "type": "string",
                        "title": "Subject",
                        "example": "Help, my printer is on fire!"
                    },
                    "description": {
                        "type": "string",
                        "title": "Description",
                        "example": "The smoke is very colorful."
                    },
                    "status": {
                        "type": "string",
                        "title": "Status",
                        "example": "open"
                    },
                    "priority": {
                        "type": "string",
                        "title": "Priority",
                        "example": "high"
                    },
                    "type": {
                        "type": "string",
                        "title": "Type",
                        "example": "incident"
                    },
                    "requester_id": {
                        "type": "integer",
                        "title": "Requester ID",
                        "example": 20978392
                    },
                    "assignee_id": {
                        "type": "integer",
                        "title": "Assignee ID",
                        "example": 235323
                    },
                    "group_id": {
                        "type": "integer",
                        "title": "Group ID",
                        "example": 98738
                    },
                    "organization_id": {
                        "type": "integer",
                        "title": "Organization ID",
                        "example": 509974
                    },
                    "tags": {
                        "type": "array",
                        "title": "Tags",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "enterprise",
                            "other_tag"
                        ]
                    },
                    "created_at": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2024-01-15T09:30:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2024-01-16T09:30:00Z"
                    },
                    "url": {
                        "type": "string",
                        "title": "URL",
                        "example": "https://example.zendesk.com/api/v2/tickets/35436.json"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "schema": {
                "type": "object",
                "properties": {
                    "ticketId": {
                        "type": "string",
                        "title": "Ticket ID",
                        "example": "35436"
                    }
                }
            }
        }
    ]
}
